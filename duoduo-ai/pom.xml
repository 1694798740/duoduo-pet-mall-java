<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-ai</artifactId>
  <name>duoduo-ai</name>
  <description>AI 导购「多多」（A9）：基于真实商品库的对话推荐，LLM 不可用时如实降级</description>

  <dependencies>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- 服务间调用：向商品域要「真实候选」（候选召回在商品域一处维护） -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <!-- 限流计数（第五十八轮 · AI 加强项）：**可选**的分布式计数。
         多实例部署时，本机内存计数会让 LLM 的实际消耗变成配额的 N 倍（不报错，只在账单上出现）。
         这里用 ObjectProvider 可选注入 —— 没有 Redis 就退回内存（本地与单实例部署完全等价），
         连不上也自动降级并冷却，绝不因为「统计个数字」把对话拖慢或拖挂。
         仍然刻意**不连数据库**：Redis 只存分钟级计数，不是业务数据面。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 刻意无数据库依赖：v1 对话是无状态检索 + 生成，会话历史留给后续
         （t_chat_session / t_chat_message 已在 01-duoduo-user.sql 预留）。
         少一个数据面就少一份迁移与备份负担，等有真实需求再加不迟。 -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-gateway</artifactId>
  <name>duoduo-gateway</name>
  <description>API 网关：统一入口、路由、JWT 前置校验、身份透传（WebFlux 响应式，单机 1w+ QPS）</description>

  <dependencies>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>

    <!-- 响应式网关。注意：不能引入 spring-boot-starter-web，否则会与 WebFlux 冲突启动失败 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway</artifactId>
    </dependency>

    <!-- 服务发现（Nacos）；本地无 Nacos 时可通过 spring.cloud.nacos.discovery.enabled=false 关闭 -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- 负载均衡：lb:// 路由必需。
         缺失时网关仍能用静态 http:// 路由（local 档），但 lb:// 会直接返回
         503 Service Unavailable 且日志无异常 —— 极易误判成网络问题。
         版本由 Spring Cloud BOM 管理。 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- E17 · 权限版本（permVersion）的感知副本读通道。
         网关要判断"这枚令牌是不是旧权限"，就得知道该用户当前的版本号；
         权威值在用户库（网关刻意不连业务库），所以由用户服务在变更/签到时
         复制一份到 Redis，网关只读它。

         为什么引非 reactive 的那个 starter：spring-data-redis 一个 jar 里
         同时带 imperative 与 reactive 实现，Boot 的 RedisReactiveAutoConfiguration
         会按 ReactiveRedisConnectionFactory 装配出 reactiveStringRedisTemplate。
         本模块是 WebFlux，**绝不能**用阻塞模板在事件循环里调用 —— 那会让整个网关卡住。

         Redis 不可用不影响启动与放行：调用点全部 onErrorResume 成"未知"（见 PermVersion 的取舍段）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

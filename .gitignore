# 构建产物
target/
**/target/

# 项目内 Maven 仓库（依赖体积大，不入库）
.m2repo/
.mvn/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.class

# 日志与本地数据
# 注意：*.log 只匹配以 .log 结尾的名字，重定向产生的 *.log.err 需要单独排除
*.log
*.log.err
*.log.txt
logs/
# data/ 忽略的是运行期数据目录（挂载卷、导出文件等）。
# ★ 例外：前端内置的行政区划数据是**源码资产**（构建期打包、随代码走），不能被忽略，
#   否则 clone 下来 `tsc` 直接找不到模块。
data/
!frontend/packages/shared/src/data/
!frontend/packages/shared/src/data/**
*.db

# 临时中间产物（构建/冒烟/调试的一次性输出）
.tmp-*

# 环境变量：只提交 .env.example
.env
.env.local
.env.*.local

# 系统
.DS_Store
Thumbs.db
miniprogram/project.private.config.json

# 前端 e2e 的浏览器运行时（scripts/e2e/node_modules，19M）：
# 刻意装进仓库目录是为了「换台机器不用重装」，但它不是源码 —— 用 package.json + npm i 重建即可。
scripts/e2e/node_modules/

# R73：订单数据备份快照（环境数据，不入库）与一次性探针输出
scripts/backup/
scripts/tmp_*

# 本地密钥（GitHub PAT 等）：只落本机，绝不入库
.secrets/

# e2e 截图默认输出（S8）：跑一次回归会产出上百张 PNG，且内容随数据/时间戳变化 ——
# 默认落到这里，避免把工作区弄脏（分不清「改了代码」还是「刚跑过回归」）。
# 真的要更新 frontend/docs/screenshots/ 里的文档配图时，显式指定 SHOTS=<路径>。
# 见 scripts/lib/e2e-shots.mjs
scripts/e2e/.shots/
.env
*.pem
*.p12
*.pfx
# 小程序端高德 Key（由 scripts/miniprogram-amap-key.mjs 从 .env 生成）
# 只提交 amap.example.js；真值不进仓库，但会随小程序包下发（平台绑定 AppID 兜底）
miniprogram/config/amap.js

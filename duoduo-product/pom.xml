<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-product</artifactId>
  <name>duoduo-product</name>
  <description>商品服务：类目树 / 品牌 / SPU-SKU / 商品搜索 / 首页聚合 / C2C 闲置浏览</description>

  <dependencies>
    <!-- 富文本详情消毒（2026-10-24）：商家提交的 HTML 必须过白名单再落库，
         不能只靠端侧清理 —— 直接调接口绕过前端的场景永远存在。 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.3</version>
    </dependency>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- E14 · 服务间调用：商品域要实时查「这个账号是不是某家店的店员」
         （成员身份在用户域，且**停用必须即时生效**，不进令牌快照、不做缓存）。
         与交易域同一套做法（InternalCallConfig 注入内部签名凭据）。
         ★ loadbalancer 不能省：@FeignClient(name="duoduo-user") 走 Nacos 服务发现，
           缺了它启动即失败（No Feign Client for loadBalancing defined）——
           这个错只在**容器启动**时炸，单元测试用 Mockito 打桩看不到。 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <!-- A10 · Elasticsearch 检索加速。只用底层 ElasticsearchClient（Java API Client），
         不用 Spring Data 仓储 —— 检索失败必须能「原地降级回 MySQL」，仓储抽象只会碍事。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
    </dependency>

    <!-- A10 · 拼音检索：应用侧生成拼音字段（免 ES 插件 —— 官方镜像即可跑，
         不引入「装插件失败→起不来」的运维面）。
         用 pinyin4j 而不是 TinyPinyin（com.github.promeg:tinypinyin）——
         后者只发布在已停服的 JCenter，Maven Central 上没有（groupId 整个 404），
         本地靠镜像缓存看不出来，CI 直连 Central 必挂（T-59）。
         选 pinyin4j：Central 在架十余年、零传递依赖、单字转拼音无音调输出即够用。 -->
    <dependency>
      <groupId>com.belerweb</groupId>
      <artifactId>pinyin4j</artifactId>
      <version>2.5.1</version>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <!-- 本地零依赖运行用 H2；生产用 MySQL（两者方言一致，切换只改配置） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

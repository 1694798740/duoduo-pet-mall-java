<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-common-web</artifactId>
  <name>duoduo-common-web</name>
  <description>Servlet 侧 Web 基础设施：全局异常处理 / 请求 ID / 登录用户上下文透传（仅业务服务依赖，网关不依赖）</description>

  <dependencies>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      定时任务选主锁（第五十八轮 · P0-2）用 JdbcTemplate 实现，故这里需要 JDBC 支持。
      业务服务都连库，因此是**已有能力的复用**而不是新增中间件。

      ★ optional=true 是必需的，不是可选的修饰（R59 实测踩到）：
      不加它时 spring-jdbc 会**传递**到 AI 服务 —— AI 是刻意无数据库的（v1 无状态对话），
      于是 DataSourceAutoConfiguration 在 AI 里被激活却拿不到 url，
      **启动直接失败**（「Failed to determine a suitable driver class」）。
      而 @ConditionalOnBean(DataSource.class) 救不了它：条件判断发生在「DataSource bean 是否注册」这一层，
      失败却发生在**更早的** DataSourceAutoConfiguration 创建 bean 那一刻。
      判据：依赖是给本模块编译用的，不是给每个使用方运行时用的 → 标 optional；
      真正连库的服务靠 mybatis-plus-starter 自己带 spring-jdbc。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      OpenAPI 契约（A6）：随 common-web 自动装配到全部业务服务，网关（WebFlux）不依赖本模块故不受影响。
      只为导出 /v3/api-docs 供契约比对与前端联调；网关路由是显式白名单，不会把 doc.html / v3/api-docs 暴露到公网入口。
      服务内直接端口（8081~8085）仅本机可达，UI（/doc.html）只在开发环境可用。
    -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
    </dependency>
    <!--
      E20 · 租户条件拦截器的 MP 适配（`com.duoduo.common.web.tenant`）需要 MP 的
      `TenantLineInnerInterceptor` 与 `TenantLineHandler` 才会编译，故本模块要能看到 MP。

      ★ 同样必须是 optional=true，理由与上面的 spring-jdbc 一模一样：
      本模块只是**编译期**用得到 MP，运行时由真正连库的服务自带
      （product / trade / fulfilment / user / social 都有 mybatis-plus-spring-boot3-starter）。
      不加 optional 时 MP 会传递到 AI 服务 —— AI 是刻意无数据库的，
      MP 的自动装配会去找 DataSource，重演 R59 那次「AI 启动直接失败」。

      副作用说明：本模块引了 MP，但**没有任何 @Configuration 会去装配它** ——
      租户拦截器由各服务在自己的 MybatisPlusInterceptor bean 里显式 add，
      不做组件扫描、不做自动装配。这是刻意的：自动装配的失效方向是
      「拦截器没注册 → 条件没追加 → 隔离静默失效」，而显式注册能被 grep 到。
    -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <!--
      第三批 · 商品 xlsx 模板 / 导入（2026-10-28）：POI 负责读写 OOXML。
      · 写：SXSSFWorkbook 流式写盘，模板/导出都不把整表读进内存；
      · 读：WorkbookFactory 只读用户上传的 xlsx（≤5MB），不碰 .xls / 加密文件。
      放 common-web 是因为「表格导入导出」是全站基建（后续导出也可能要 xlsx），
      不是商品域私有能力；POI 无自动装配，不会像 spring-jdbc 那样影响无库服务启动。
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-common-web</artifactId>
  <name>duoduo-common-web</name>
  <description>Servlet 侧 Web 基础设施：全局异常处理 / 请求 ID / 登录用户上下文透传（仅业务服务依赖，网关不依赖）</description>

  <dependencies>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      OpenAPI 契约（A6）：随 common-web 自动装配到全部业务服务，网关（WebFlux）不依赖本模块故不受影响。
      只为导出 /v3/api-docs 供契约比对与前端联调；网关路由是显式白名单，不会把 doc.html / v3/api-docs 暴露到公网入口。
      服务内直接端口（8081~8085）仅本机可达，UI（/doc.html）只在开发环境可用。
    -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>

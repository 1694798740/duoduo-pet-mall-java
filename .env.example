# 环境变量模板 —— 复制为 .env 后填真实值（.env 已在 .gitignore，不会进仓库）
#
# 说明：docker-compose.yml 里所有可变项都写成 ${VAR:-默认值}，因此
#   ① 不建 .env 也能起（走默认值）；
#   ② 建了 .env 就按 .env 覆盖。
# **真实密钥只放 .env 或 shell 环境变量，绝不写进 compose / 代码 / 文档。**

# ── 服务间共享密钥（内部接口鉴权，全站同一个）────────────────────
INTERNAL_TOKEN=duoduo-local-dev-internal-token

# ── AI 导购「多多」（duoduo-ai，A9）──────────────────────────────
# 阿里云百炼（DashScope）API Key。留空 = AI 以 unconfigured 形态降级（接口 503，不进模型）。
# 申请入口：https://bailian.console.aliyun.com/  → API-KEY 管理
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx（**不要**把真实值提交到仓库）
DASHSCOPE_API_KEY=

# 模型名。导购场景「按条件筛选 + 组织话术」用 qwen-plus 已够；追求更高质量可换 qwen-max（成本更高）
# 支持逗号分隔的模型优先级列表（书写顺序=优先顺序）：主力额度用尽/限流/不存在/上游故障时
# 按顺序自动切换到下一个备选（401 Key 无效不切换）；平台免费额度按模型独立计算
DUODUO_AI_MODEL=qwen3.8-flash,qwen3.7-flash-2026-07-15,kimi-k3

# mock 开关：
#   true  —— 不调模型，用确定性规则把**真实召回结果**拼成回复（本地 / CI 默认；省配额、结果可断言）
#   false —— 调真实模型（需要 DASHSCOPE_API_KEY 非空，否则每次对话 503）
DUODUO_AI_MOCK_ENABLED=true

# 对话超时（秒）。超时按 DEGRADED(503) 处理，不挂死请求线程
DUODUO_AI_TIMEOUT_SECONDS=15

# 每 IP 每分钟对话次数上限。超限 429 RATE_LIMITED —— 保护 LLM 配额的第一道闸
DUODUO_AI_RATE_LIMIT=20

# ── Elasticsearch 检索（A10，可选加速层）────────────────────────
# duoduo-es 容器属 compose 的 search profile，默认不起：
#   起：docker compose --profile search up -d
# 开关为 false 时检索链路原地降级回 MySQL，功能不受影响（只少了拼音/同义词召回）
DUODUO_SEARCH_ENABLED=false

# ── 网关运行期开关（E8 / E17 / E21 / E24）────────────────────────
#
# ★ 这些开关的共同点：**关掉就退回旧行为**，用于排障与回滚。
#   完整清单（含每项的「关掉会怎样」）见 docs/OPS.md；
#   一条命令核到实物（清单 ↔ compose ↔ yml ↔ 容器）：scripts\ops-switch.ps1 -Check
#
#   改完只需**重建容器**（不必重新打镜像）：
#     docker compose up -d --force-recreate --no-deps duoduo-gateway-app

# E8 · 入口收窄：/api/admin/** 只允许后台、/api/seller/** 只允许商家端访问
#   ★ 置 false 会让**三端入口隔离失效**（小程序/商城令牌也能调另两端专属接口），
#     仅排障时临时关闭，事后必须改回 true。
DUODUO_ENTRY_SCOPE_ENABLED=true

# E17 · 权限版本校验：改完角色「下一个请求即生效」
#   置 false = 退回旧行为（角色变更要等令牌自然过期，≤15 分钟）。
#   注意：授权判定本身不受影响，变的只是生效时延。
DUODUO_PERM_VERSION_ENABLED=true

# E24 · 租户接口调用计数（后台「租户健康度」面板第四维的数据源）
#   ★ 置 false **不会报错**，只会让面板那一维恒为 0（典型静默失效），默认必须是开。
DUODUO_API_METRICS_ENABLED=true

# E21 · 后台访问 IP 白名单（默认关）
#   ★ 打开前必须先把下面的名单配全 —— 开关打开 + 名单为空 = **拒绝全部后台访问**
#     （失败关闭是刻意的：安全配置的失效方向必须指向「拒绝」）。
DUODUO_ADMIN_IP_WHITELIST_ENABLED=false
# 逗号分隔，三种写法可混用：精确地址 / CIDR / 前缀通配
# 例：DUODUO_ADMIN_IP_WHITELIST=203.0.113.7,10.0.0.0/8,192.168.1.*
DUODUO_ADMIN_IP_WHITELIST=

# ── AI 其余阈值（R57 加强项）────────────────────────────────────
# 全站每分钟 AI 调用总上限（单键限流防不住换 IP 刷，这一层保证总有上界）
DUODUO_AI_GLOBAL_RATE_LIMIT=300
# 商品召回跨域调用的读超时（毫秒）；与 LLM 超时分开，避免商品域慢拖垮 AI
DUODUO_AI_RECALL_READ_TIMEOUT_MS=1500

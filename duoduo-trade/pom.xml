<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.duoduo</groupId>
    <artifactId>duoduo-pet-mall</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>duoduo-trade</artifactId>
  <name>duoduo-trade</name>
  <description>交易服务：购物车 / 下单拆单 / 库存冻结 / 订单状态机 / 支付幂等 / C2C 担保交易 / 卖家中心</description>

  <dependencies>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.duoduo</groupId>
      <artifactId>duoduo-common-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>

    <!-- 调用商品服务取 SKU 快照（加购校验 / 下单快照）。Feign 负责声明式调用，
         loadbalancer 负责把 duoduo-product 解析成 Nacos 里的真实实例（lb:// 语义）。 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <!-- 本地零依赖运行用 H2；生产用 MySQL（两者方言一致，切换只改配置） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- A11 · 削峰队列：RocketMQ 客户端（原生 4.x remoting 协议，自管生命周期）。
         不用 rocketmq-spring-boot-starter：Boot 3 兼容版本轮换频繁，而本项目只需要
         「一个 topic 的生产者 + 一个消费者 + DLQ 查询」，自己包一层 lifecycle 反而更少魔法。
         版本 4.9.8 与服务端 apache/rocketmq:5.x 的 remoting 协议兼容。 -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>4.9.8</version>
    </dependency>
    <!-- 死信查询用 DefaultMQAdminExt（queryMessage 按 keys 检索）在 tools 包里 -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-tools</artifactId>
      <version>4.9.8</version>
    </dependency>

    <!-- A11 · 限流：Sentinel 核心（版本对齐 spring-cloud-alibaba 2023.0.1.0 所管理的 1.8.6）。
         不引 sentinel dashboard / starter：限流规则在代码里按配置定义即可，
         BlockException 在入口翻译成全站既有的 RATE_LIMITED(429)。 -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-core</artifactId>
      <version>1.8.6</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

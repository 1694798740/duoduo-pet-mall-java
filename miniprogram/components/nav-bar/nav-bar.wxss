/* 占位块：与固定条同色同高，滚动时不露底色 */
.nb-ph {
  background: #4f6ef7;
}

.nb {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
  box-sizing: border-box;
  background: #4f6ef7;
}

.nb-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 200rpx; /* 两侧留白，避免标题压到胶囊按钮 */
}

.nb-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 下拉刷新指示器（原生三点指示器在自绘导航栏下会被遮挡，这里自绘一个） */
.nb-spin {
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  animation: nb-spin 0.8s linear infinite;
}

@keyframes nb-spin {
  to { transform: rotate(360deg); }
}

/* 右侧命名插槽容器（第四十八轮）：垂直居中于标题栏，水平位置按胶囊实算内联给出 */
.nb-right {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  display: flex;
  align-items: center;
}

/* 左上角返回键（第五十轮）：非 tab 页推进式打开的返回路径，白箭头与标题同色系 */
.nb-back {
  position: absolute;
  left: 4rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx 24rpx;
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.nb-back-hover {
  opacity: 0.6;
}

/* 右上角通知图标（第五十轮）：全页面统一入口，💬 短信样式，点击进通知中心 */
.nb-msg {
  padding: 8rpx 4rpx;
  margin-right: 8rpx;
}

.nb-msg-hover {
  opacity: 0.6;
}

.nb-msg-icon {
  font-size: 36rpx;
  line-height: 1;
}

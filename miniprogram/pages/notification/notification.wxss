/* 通知中心（第五十轮）：列表风格与私信列表一致，蓝点标记未读 */

.msg-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.me-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.me-main {
  flex: 1;
  min-width: 0;
}

.me-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.me-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.badge {
  min-width: 34rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.arrow {
  color: #d1d5db;
  font-size: 32rpx;
}

.card-hover {
  opacity: 0.75;
}

.readall-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 32rpx 8rpx;
}

.readall-link {
  font-size: 24rpx;
  color: #4f6ef7;
}

/* 分类筛选胶囊（第五十五轮）
 *
 * 四条齐备才不会被拉成椭圆：显式 height + line-height:1 的替代（line-height 等于 height）
 * + border-radius = height/2 + 容器 align-items:center。
 * 第五十四轮的教训：scroll-view 内 flex 子项默认 align-items:stretch，
 * 只要容器没写 align-items，胶囊就会被撑成整个滚动区的高度。 */
.chips {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.chip {
  flex-shrink: 0;
  /* inline-flex 而不是靠 line-height 居中：chip 里现在有两个节点（文字 + 角标），
     line-height 方案会让角标把整行撑高、或者文字与角标基线错位 */
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: var(--gray-weak);
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1;
}

.chip-on {
  background: #4f6ef7;
  color: #fff;
}

/* 分类未读角标（2026-10-27）：>99 由 js/wxml 截成 99+ */
.chip-badge {
  margin-left: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #e5484d;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 分页状态提示 */
.list-tip {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

.notice-list {
  margin: 8rpx 24rpx 24rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: 16rpx;
}

.notice-read {
  opacity: 0.62;
}

.n-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.n-main {
  flex: 1;
  min-width: 0;
}

.n-title {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.dot {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: #4f6ef7;
  flex-shrink: 0;
}

.n-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.n-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.empty {
  padding: 140rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.login-btn {
  margin-top: 24rpx;
}

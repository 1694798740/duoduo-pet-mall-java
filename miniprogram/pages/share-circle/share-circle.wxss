/* ── 分享圈信息流（第四十三轮） ── */
.sc-item { margin-bottom: 20rpx; }

.sc-head { display: flex; align-items: center; gap: 20rpx; }
.sc-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  flex: none;
}
.sc-head-info { flex: 1; min-width: 0; }

.sc-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  word-break: break-all;
}

.sc-product {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--bg);
}
.sc-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: var(--card);
  flex: none;
}
.sc-p-info { flex: 1; min-width: 0; }
.sc-p-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sc-arrow { color: var(--text-3); font-size: 32rpx; }

/* ── 互动条（第四十四轮）：点赞 / 收藏 / 转发 ── */
.sc-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.sc-act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 4rpx 0;
}
.sc-act-on { color: var(--brand); font-weight: 600; }

/* ── 转发引用块（第四十六轮）：署名原作者 + 引出原评价 ── */
.sc-quote {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--bg);
  border-left: 6rpx solid var(--line);
}
.sc-quote-hd { font-size: 24rpx; color: var(--brand); margin-bottom: 8rpx; }
.sc-quote-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
  word-break: break-all;
}

.sc-end { text-align: center; padding: 24rpx 0 40rpx; }

/* ── 转发弹层（第四十六轮） ── */
.sc-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 20, 28, 0.45);
  z-index: 300;
}
.sc-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sc-panel-title { font-size: 32rpx; font-weight: 700; text-align: center; }
.sc-panel-sub { font-size: 24rpx; text-align: center; margin-top: 8rpx; }
.sc-panel-input {
  width: 100%;
  height: 160rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 26rpx;
  background: var(--bg);
}
.sc-panel-ph { color: var(--text-3); }
.sc-panel-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sc-panel-btn { flex: 1; height: 80rpx; line-height: 80rpx; }
.sc-panel-cancel {
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

/* ── 推荐 / 关注 双 tab + 我的分享入口（第五十六轮）─────────────────────────
   两条不变量：容器 align-items:center（阻止 tab 胶囊被拉伸到与容器等高）、
   每个成员 flex:none（不被压缩 → 文字不折行）。这是 R54 定下的胶囊/横排纪律。 */
.sc-tabs {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  background: var(--card);
}
.sc-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 60rpx;
  line-height: 1;
  padding: 0 32rpx;
  border-radius: 30rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 28rpx;
  white-space: nowrap;
}
.sc-tab-on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}
.sc-mine {
  margin-left: auto;
  flex: none;
  font-size: 26rpx;
  color: var(--brand);
  white-space: nowrap;
}

/* 话题标签（第五十六轮）：与 .sc-tab 同一套胶囊纪律 */
.sc-topics {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}
.sc-topic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 44rpx;
  line-height: 1;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: var(--brand-weak, var(--brand-weak));
  color: var(--brand);
  font-size: 23rpx;
  white-space: nowrap;
}

/* 举报按钮推到互动条最右：与点赞/收藏拉开距离，避免误触 */
.sc-act-more { margin-left: auto; }

/* 举报理由列表（第五十六轮） */
.sc-report-list { margin-top: 24rpx; }
.sc-report-item {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

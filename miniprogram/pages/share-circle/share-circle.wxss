/* ── 分享圈信息流（第四十三轮） ── */
.sc-item { margin-bottom: 20rpx; }

.sc-head { display: flex; align-items: center; gap: 20rpx; }
.sc-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  flex: none;
}
.sc-head-info { flex: 1; min-width: 0; }

.sc-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  word-break: break-all;
}

.sc-product {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--bg);
}
.sc-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #fff;
  flex: none;
}
.sc-p-info { flex: 1; min-width: 0; }
.sc-p-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sc-arrow { color: var(--text-3); font-size: 32rpx; }

/* ── 互动条（第四十四轮）：点赞 / 收藏 / 转发 ── */
.sc-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.sc-act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 4rpx 0;
}
.sc-act-on { color: var(--brand); font-weight: 600; }

/* ── 转发引用块（第四十六轮）：署名原作者 + 引出原评价 ── */
.sc-quote {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: var(--bg);
  border-left: 6rpx solid var(--line);
}
.sc-quote-hd { font-size: 24rpx; color: var(--brand); margin-bottom: 8rpx; }
.sc-quote-body {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
  word-break: break-all;
}

.sc-end { text-align: center; padding: 24rpx 0 40rpx; }

/* ── 转发弹层（第四十六轮） ── */
.sc-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 20, 28, 0.45);
  z-index: 300;
}
.sc-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sc-panel-title { font-size: 32rpx; font-weight: 700; text-align: center; }
.sc-panel-sub { font-size: 24rpx; text-align: center; margin-top: 8rpx; }
.sc-panel-input {
  width: 100%;
  height: 160rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 26rpx;
  background: var(--bg);
}
.sc-panel-ph { color: var(--text-3); }
.sc-panel-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sc-panel-btn { flex: 1; height: 80rpx; line-height: 80rpx; }
.sc-panel-cancel {
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

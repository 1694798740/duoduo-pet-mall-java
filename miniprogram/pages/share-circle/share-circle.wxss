/* ── 分享圈信息流（第四十三轮） ── */
.sc-item { margin-bottom: 20rpx; }

.sc-head { display: flex; align-items: center; gap: 20rpx; }
.sc-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg);
  flex: none;
}
.sc-head-info { flex: 1; min-width: 0; }

.sc-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  word-break: break-all;
}

.sc-product {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--bg);
}
.sc-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #fff;
  flex: none;
}
.sc-p-info { flex: 1; min-width: 0; }
.sc-p-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sc-arrow { color: var(--text-3); font-size: 32rpx; }

.sc-end { text-align: center; padding: 24rpx 0 40rpx; }

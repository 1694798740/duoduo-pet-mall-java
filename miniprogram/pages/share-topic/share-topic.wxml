<nav-bar title="{{name ? '#' + name : '话题广场'}}" back="{{true}}" />

<!-- 话题广场形态：热门话题榜 -->
<block wx:if="{{!name}}">
  <view wx:if="{{!hot.length && !hotLoading}}" class="empty">还没有话题，去分享时带上 #话题 试试</view>
  <block wx:else>
    <view class="card">
      <view class="st-hot-title">大家都在聊</view>
      <view wx:for="{{hot}}" wx:key="name" class="st-hot-item" data-name="{{item.name}}" bindtap="goTopic">
        <text class="st-hot-name">#{{item.name}}</text>
        <text class="st-hot-count t3">{{item.shareCount}} 条分享</text>
      </view>
    </view>
    <view style="height: 40rpx"></view>
  </block>
</block>

<!-- 话题聚合形态 -->
<block wx:else>
  <view class="st-head">
    <view class="st-head-name">#{{name}}</view>
    <view class="st-head-sub t3">
      {{topicShareCount ? topicShareCount + ' 条分享' : '共 ' + total + ' 条分享'}}
    </view>
  </view>

  <view wx:if="{{error && items.length === 0}}" class="error-box">
    <view>{{error}}</view>
    <button class="btn btn-plain btn-mini" bindtap="retry">重试</button>
  </view>

  <view wx:elif="{{items.length === 0 && !loading}}" class="empty">
    <view>这个话题下还没有分享</view>
    <button class="btn btn-plain btn-mini st-go" bindtap="goShareCircle">去分享圈发一条</button>
  </view>

  <block wx:else>
    <view wx:for="{{items}}" wx:key="id" class="card st-item">
      <view class="st-user">
        <image class="st-avatar" src="{{item.avatar || '/images/category/default.png'}}" mode="aspectFill" />
        <view class="st-user-info">
          <view class="t2">{{item.nickname}}</view>
          <view class="t3">{{item.timeText}}{{item.isRepost ? ' · 转发' : ''}}</view>
        </view>
      </view>
      <view wx:if="{{item.content}}" class="st-content" data-id="{{item.id}}" bindtap="goDetail">{{item.content}}</view>
      <view class="st-product" data-spu="{{item.spuId}}" bindtap="goProduct">
        <image class="st-img" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view class="st-p-info">
          <view class="st-p-title">{{item.productTitle}}</view>
          <view class="price">¥{{item.priceText}}</view>
        </view>
      </view>
      <view class="st-topics">
        <text
          wx:for="{{item.topics}}"
          wx:for-item="tag"
          wx:key="*this"
          class="st-topic {{tag === name ? 'st-topic-on' : ''}}"
          data-name="{{tag}}"
          catchtap="goTopic"
        >#{{tag}}</text>
      </view>
      <view class="st-stats t3">
        ❤️ {{item.likeCount}} · ⭐ {{item.favoriteCount}} · 💬 {{item.commentCount || 0}}
      </view>
      <view class="st-open" data-id="{{item.id}}" bindtap="goDetail">查看详情 ›</view>
    </view>

    <view wx:if="{{noMore && items.length > 0}}" class="t3 st-end">— 到底啦 —</view>
    <view wx:elif="{{loading}}" class="t3 st-end">加载中…</view>
    <view style="height: 40rpx"></view>
  </block>
</block>

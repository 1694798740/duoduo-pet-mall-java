/* ── 话题聚合页 / 话题广场（第五十六轮） ── */
.st-head {
  padding: 24rpx 24rpx 8rpx;
}
.st-head-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  word-break: break-all;
}
.st-head-sub { font-size: 24rpx; margin-top: 8rpx; }

.st-go { margin-top: 24rpx; }

.st-hot-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.st-hot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.st-hot-item:last-child { border-bottom: none; }
.st-hot-name {
  font-size: 29rpx;
  color: var(--brand);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.st-hot-count { font-size: 24rpx; flex: none; }

.st-item { margin-bottom: 20rpx; }
.st-user { display: flex; align-items: center; gap: 16rpx; }
.st-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg);
  flex: none;
}
.st-user-info { flex: 1; min-width: 0; }
.st-content {
  font-size: 28rpx;
  line-height: 1.7;
  margin-top: 12rpx;
  word-break: break-all;
}
.st-product {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--bg);
  border-radius: 14rpx;
}
.st-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: var(--card);
  flex: none;
}
.st-p-info { flex: 1; min-width: 0; }
.st-p-title {
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 话题胶囊：四条齐备（显式高度 / line-height:1 / 半径=半高 / 容器 align-items:center） */
.st-topics {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}
.st-topic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 44rpx;
  line-height: 1;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: var(--brand-weak, var(--brand-weak));
  color: var(--brand);
  font-size: 23rpx;
  white-space: nowrap;
}
.st-topic-on {
  background: var(--brand);
  color: #fff;
}

.st-stats { font-size: 23rpx; margin-top: 14rpx; }
.st-open {
  margin-top: 12rpx;
  text-align: right;
  color: var(--brand);
  font-size: 25rpx;
}
.st-end { text-align: center; padding: 20rpx 0; }

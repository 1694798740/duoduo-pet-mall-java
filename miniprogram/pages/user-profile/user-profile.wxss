.up-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.up-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  flex: none;
}
.up-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}
.up-nick {
  font-size: 34rpx;
  font-weight: 600;
}

.up-stats {
  display: flex;
}
.up-stat {
  flex: 1;
  text-align: center;
}
.up-num {
  font-size: 36rpx;
  font-weight: 700;
}

.up-actions {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 24rpx;
}
.up-btn {
  flex: 1;
}

.up-self-hint {
  text-align: center;
  margin: 30rpx 0 10rpx;
}
.up-tip {
  text-align: center;
  margin: 20rpx 40rpx;
  font-size: 24rpx;
}

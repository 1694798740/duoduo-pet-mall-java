<nav-bar title="登录" back="{{true}}" />

<view class="login-wrap">
  <view class="card">
    <view class="login-title">登录多多宠物商店</view>

    <!-- 微信一键登录：AppID 已配置时可用；未绑定的微信会引导到下方手机号入口 -->
    <block wx:if="{{wechatReady}}">
      <button
        class="btn-primary login-btn"
        bindtap="wechatLogin"
        disabled="{{submitting}}"
        loading="{{submitting}}"
      >
        微信一键登录
      </button>
      <view class="login-tip">若提示「微信还没绑定账号」，点下方「手机号登录 / 注册新账号」即可，<text class="login-tip-strong">登录后会自动绑定当前微信</text>，之后就能一键登录</view>
    </block>

    <!-- 「微信还没绑定账号」的页面内引导（不依赖 wx.showModal，必然可见） -->
    <view wx:if="{{bindTip}}" class="bind-tip">
      <view class="bind-tip-head">
        <text class="bind-tip-title">{{bindTip.title}}</text>
        <text class="bind-tip-close" bindtap="dismissBindTip">✕</text>
      </view>
      <view class="bind-tip-content">{{bindTip.content}}</view>
      <view wx:if="{{bindTip.action}}" class="bind-tip-btn" bindtap="onBindTipAction">
        {{bindTip.actionText || '继续'}}
      </view>
    </view>

    <!-- 从「微信未绑定」转过来时，明确告诉用户这步会顺手完成绑定 -->
    <view wx:if="{{pendingWechatBind}}" class="login-bind-tip">
      用手机号登录/注册后，会自动把当前微信绑定到这个账号
    </view>

    <!-- 手机号登录 / 注册：始终可见（新用户唯一的开户入口） -->
    <view class="login-mode">
      <view
        class="mode-item {{mode === 'phone' ? 'mode-active' : ''}}"
        data-mode="phone"
        bindtap="switchMode"
      >手机号登录</view>
      <view
        class="mode-item {{mode === 'register' ? 'mode-active' : ''}}"
        data-mode="register"
        bindtap="switchMode"
      >注册新账号</view>
    </view>

    <input
      class="login-input"
      type="number"
      maxlength="11"
      placeholder="手机号"
      value="{{phone}}"
      bindinput="onPhone"
      disabled="{{totpStep}}"
    />

    <!-- 第二步：两步验证。密码已在第一步通过，这里只收验证码 / 恢复码 -->
    <block wx:if="{{totpStep}}">
      <view class="login-bind-tip">
        该账号已开启两步验证：请输入认证器上的{{useRecovery ? '恢复码' : ' 6 位动态码'}}完成登录
      </view>
      <input
        class="login-input"
        maxlength="{{useRecovery ? 32 : 6}}"
        type="{{useRecovery ? 'text' : 'number'}}"
        placeholder="{{useRecovery ? '恢复码（一次性）' : '6 位动态码'}}"
        value="{{totpCode}}"
        bindinput="onTotpCode"
      />
      <view class="login-tip">
        <text class="login-tip-strong" bindtap="toggleRecovery">
          {{useRecovery ? '改用认证器动态码' : '手机不在身边？改用恢复码'}}
        </text>
      </view>
    </block>

    <input
      wx:if="{{!totpStep}}"
      class="login-input"
      password
      maxlength="64"
      placeholder="{{mode === 'register' ? '密码（8-64 位）' : '密码'}}"
      value="{{password}}"
      bindinput="onPassword"
    />
    <input
      wx:if="{{mode === 'register' && !totpStep}}"
      class="login-input"
      maxlength="20"
      placeholder="昵称（选填）"
      value="{{nickname}}"
      bindinput="onNickname"
    />

    <button
      class="btn-primary login-btn"
      bindtap="submitPhone"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{totpStep ? '验证并登录' : (mode === 'register' ? '注册并登录' : '登录')}}
    </button>

    <view class="login-tip">
      {{totpStep
        ? '验证码每 30 秒刷新一次；恢复码只能用一次，用过即作废'
        : (mode === 'register' ? '注册即创建多多账号，手机号将作为登录账号' : '忘记密码？当前版本请通过 Web 端「我的」重置')}}
    </view>
  </view>
</view>

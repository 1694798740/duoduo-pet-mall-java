.login-wrap {
  padding-top: 120rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  text-align: center;
}

.login-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}

.login-tip {
  color: #999;
  font-size: 24rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}

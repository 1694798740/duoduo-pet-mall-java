.login-wrap {
  padding-top: 120rpx;
}

.login-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 「登录后将自动绑定微信」提示条 */
.login-bind-tip {
  background: var(--brand-weak);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

/* 手机号登录 / 注册 切换 */
.login-mode {
  display: flex;
  background: #f5f6fa;
  border-radius: 32rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}
.mode-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 14rpx 0;
  border-radius: 28rpx;
}
.mode-active {
  background: #fff;
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(35, 38, 47, 0.06);
}

.login-input {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 100%;
  margin-top: 8rpx;
}

.login-tip {
  color: #999;
  font-size: 24rpx;
  margin-top: 24rpx;
  line-height: 1.6;
}

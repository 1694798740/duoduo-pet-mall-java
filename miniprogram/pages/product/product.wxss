/* ── 商品图集 ── */
.p-media {
  padding: 16rpx 16rpx 12rpx;
}
.p-swiper {
  width: 100%;
  height: 640rpx;
}
.p-swiper-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: var(--bg);
}
.p-thumbs {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.p-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--bg);
  border: 2rpx solid transparent;
}
.p-thumb-on {
  border-color: var(--brand);
}

/* 供货身份标签（第七十三轮）：自营=暖橙实底、入驻=灰底描边，与 Web 端 .tag/.tag-self 同语言 */
.p-supply { margin-bottom: 10rpx; }
.tag-self { background: #fff3ec; color: #d9640f; }
.tag-merchant { background: var(--gray-weak); color: var(--text-3); border: 1rpx solid var(--border); }

.p-title { font-size: 34rpx; font-weight: 700; margin-bottom: 12rpx; }
.p-price-row { display: flex; align-items: center; justify-content: space-between; }
.p-price { font-size: 40rpx; }
.sec-title { font-weight: 700; margin-bottom: 16rpx; }

/* ── 规格：缩略图 + 规格名 + 价格（三列信息一眼看清） ── */
.sku-list { display: flex; flex-direction: column; gap: 16rpx; }
.sku {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 26rpx;
}
.sku-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  flex: none;
  background: var(--bg);
}
.sku-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sku-price { color: var(--accent); font-weight: 600; }
.sku-active { border-color: var(--brand); background: var(--brand-weak); color: var(--brand); }
.sku-disabled { color: var(--text-3); background: var(--bg); }
.sku-disabled .sku-price { color: var(--text-3); }

.review-item { border-bottom: 1rpx solid var(--line); padding: 16rpx 0; }
.review-item:last-child { border-bottom: none; }
.review-head { display: flex; justify-content: space-between; margin-bottom: 8rpx; font-size: 24rpx; }
.review-content { font-size: 26rpx; color: var(--text); line-height: 1.6; }
.p-desc { color: var(--text-2); line-height: 1.7; }

/* ── 规格参数 / 包装规格（第四十二轮）：两列「名 + 值」，随选中规格联动 ── */
.spec-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}
.spec-row:last-child { border-bottom: none; }
.spec-k { width: 180rpx; flex: none; color: var(--text-3); }
.spec-v { flex: 1; color: var(--text); }

/* ── 图文详情配图（第四十二轮） ── */
.detail-media { margin-top: 20rpx; }
.detail-img {
  width: 100%;
  border-radius: 12rpx;
  background: var(--bg);
}

/* ── 底部操作栏：分享（open-type=share）+ 加购 + 立即购买 ── */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
/* 第五十三轮热修二：四个按钮同排时给足文字空间，否则「加入购物车」「立即购买」被压成两行。
   显式声明 padding 与 font-size（不再吃小程序 button 默认内边距），四个按钮高度统一 76rpx。 */
.footer-share {
  width: 120rpx;
  height: 76rpx;
  flex: none;
  margin: 0;
  padding: 0;
  font-size: 26rpx;
}
.footer-btn {
  flex: 1;
  height: 76rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  white-space: nowrap;
}
/* 加入购物车用描边样式与「立即购买」实心主按钮区分层级 */
.footer .btn-plain.footer-btn { border: 2rpx solid var(--brand); color: var(--brand); }

/* ── 分享面板（第四十三轮）：底部弹层，写评价 → 转发好友 / 发布到分享圈 ── */
.sp-mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 20, 28, 0.45);
  z-index: 300;
}
.sp-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}
.sp-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.sp-input {
  width: 100%;
  height: 160rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 26rpx;
  background: var(--bg);
}
.sp-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sp-btn { flex: 1; height: 80rpx; line-height: 80rpx; }
.sp-link {
  text-align: center;
  color: var(--brand);
  font-size: 26rpx;
  margin-top: 20rpx;
}
.sp-cancel {
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

/* 话题输入框（第五十六轮）：复用 .sp-input 的边框与底色，只把高度改成单行 */
.sp-tags {
  height: 76rpx;
  margin-top: 16rpx;
}

/* 富文本详情（2026-10-24）：rich-text 内部图片不溢出 */
.p-rich { display: block; font-size: 28rpx; color: #4b5563; line-height: 1.8; }
.p-rich image { max-width: 100%; }

<view wx:if="{{error}}" class="empty">{{error}}</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:elif="{{detail}}">
  <view class="card">
    <view class="p-title">{{detail.title}}</view>
    <view class="p-price price">¥{{detail.minPrice / 100}}</view>
  </view>

  <view class="card">
    <view class="sec-title">选择规格</view>
    <view class="sku-list">
      <view
        wx:for="{{detail.skus}}"
        wx:key="skuId"
        class="sku {{index === selectedSkuIndex ? 'sku-active' : ''}} {{item.availableStock <= 0 ? 'sku-disabled' : ''}}"
        data-index="{{index}}"
        bindtap="selectSku"
      >
        {{item.specText}}（¥{{item.price / 100}}）
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">商品介绍</view>
    <text class="p-desc">{{detail.description || '暂无介绍'}}</text>
  </view>

  <view class="footer">
    <button class="btn-primary footer-btn" bindtap="addCart" disabled="{{adding}}" loading="{{adding}}">
      加入购物车
    </button>
  </view>
</block>

<nav-bar title="商品详情" back="{{true}}" />

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="fetchDetail">重试</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:elif="{{detail}}">
  <!-- 商品图集：统一 1:1 出图，点击可全屏预览 -->
  <view class="card p-media">
    <swiper
      class="p-swiper"
      indicator-dots="{{detail.gallery.length > 1}}"
      indicator-color="rgba(35,38,47,0.15)"
      indicator-active-color="#4f6ef7"
      circular="{{detail.gallery.length > 1}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{detail.gallery}}" wx:key="*this">
        <image
          class="p-swiper-img"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="previewImage"
          lazy-load
        />
      </swiper-item>
    </swiper>
    <view wx:if="{{detail.gallery.length > 1}}" class="p-thumbs">
      <image
        wx:for="{{detail.gallery}}"
        wx:key="*this"
        class="p-thumb {{swiperIndex === index ? 'p-thumb-on' : ''}}"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
      />
    </view>
  </view>

  <view class="card">
    <view class="p-title">{{detail.title}}</view>
    <view wx:if="{{detail.subtitle}}" class="t3">{{detail.subtitle}}</view>
    <view class="p-price-row">
      <view class="price p-price">{{detail.minPriceText}}</view>
      <view class="t3">已售 {{detail.salesCount}}</view>
      <view class="tag tag-brand" bindtap="askAi">🤖 问问 AI</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">选择规格</view>
    <view wx:if="{{detail.skus.length === 0}}" class="t3">该商品暂无可售规格</view>
    <view wx:else class="sku-list">
      <view
        wx:for="{{detail.skus}}"
        wx:key="id"
        class="sku {{index === selectedSkuIndex ? 'sku-active' : ''}} {{item.stock <= 0 || !item.sellable ? 'sku-disabled' : ''}}"
        data-index="{{index}}"
        bindtap="selectSku"
      >
        <image class="sku-thumb" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
        <text class="sku-text">{{item.specText}}</text>
        <text class="sku-price">¥{{item.priceText}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">用户评价{{reviewSummary && reviewSummary.total > 0 ? '（' + reviewSummary.total + '）' : ''}}</view>
    <view wx:if="{{reviews.length === 0}}" class="t3">暂无评价</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-item">
      <view class="review-head">
        <text class="t2">{{item.nickname || '匿名用户'}}</text>
        <text class="t3">{{item.rating || 5}} 星</text>
      </view>
      <view class="review-content">{{item.content}}</view>
    </view>
  </view>

  <!-- 规格参数：只展示后端真实下发的字段（品牌/分类/适用/过敏原），随选中规格更新 -->
  <view wx:if="{{params.length > 0}}" class="card">
    <view class="sec-title">规格参数</view>
    <view wx:for="{{params}}" wx:key="k" class="spec-row">
      <text class="spec-k">{{item.k}}</text>
      <text class="spec-v">{{item.v}}</text>
    </view>
  </view>

  <!-- 包装规格：来自 SKU spec 键值对 + SKU 编码 + 库存 -->
  <view wx:if="{{packageRows.length > 0}}" class="card">
    <view class="sec-title">包装规格</view>
    <view wx:for="{{packageRows}}" wx:key="k" class="spec-row">
      <text class="spec-k">{{item.k}}</text>
      <text class="spec-v">{{item.v}}</text>
    </view>
  </view>

  <!-- 商品介绍：详情长文 + 图文配图 -->
  <view class="card">
    <view class="sec-title">商品介绍</view>
    <text class="p-desc">{{detail.description || '暂无介绍'}}</text>
    <view wx:for="{{detailImages}}" wx:key="*this" class="detail-media">
      <image class="detail-img" src="{{item}}" mode="widthFix" lazy-load />
    </view>
  </view>

  <view style="height: 140rpx"></view>
  <view class="footer">
    <!-- 第四十七轮：问一问 —— 直接向卖家发起咨询（ASK 豁免一条限制，无需互关） -->
    <button class="btn btn-plain footer-share" bindtap="askSeller" size="mini">问一问</button>
    <!-- 第四十三轮：分享按钮不再直接 open-type=share —— 先过登录校验（未登录引导登录），
         已登录弹出分享面板（写评价 → 转发好友 / 发布到分享圈） -->
    <button class="btn btn-plain footer-share" bindtap="onShareTap" size="mini">分享</button>
    <button
      class="btn btn-plain footer-btn"
      bindtap="addCart"
      disabled="{{adding || detail.skus.length === 0}}"
      loading="{{adding}}"
    >
      加入购物车
    </button>
    <button
      class="btn btn-accent footer-btn"
      bindtap="buyNow"
      disabled="{{detail.skus.length === 0}}"
    >
      立即购买
    </button>
  </view>

  <!-- 分享面板（底部弹层）：open-type=share 只能由用户点按触发，放在已登录才可达的面板里 -->
  <view wx:if="{{showSharePanel}}" class="sp-mask" bindtap="closeSharePanel">
    <view class="sp-panel" catchtap="noop">
      <view class="sp-title">分享这个商品</view>
      <textarea
        class="sp-input"
        placeholder="写点评价，说说好在哪…（发布到分享圈必填）"
        value="{{shareContent}}"
        bindinput="onShareContentInput"
        maxlength="500"
      />
      <!-- 话题（第五十六轮）：最多 2 个，空格分隔；不填也能发布 -->
      <input
        class="sp-input sp-tags"
        placeholder="加话题（选填，最多 2 个，空格分隔，不用打 #）"
        value="{{shareTopics}}"
        bindinput="onShareTopicsInput"
        maxlength="70"
      />
      <view class="sp-actions">
        <button class="btn btn-plain sp-btn" open-type="share" bindtap="onForwardTap">
          转发给好友
        </button>
        <button
          class="btn btn-accent sp-btn"
          bindtap="publishShare"
          loading="{{publishing}}"
          disabled="{{publishing}}"
        >
          发布到分享圈
        </button>
      </view>
      <view class="sp-link" bindtap="goShareCircle">先去分享圈逛逛 ›</view>
      <view class="sp-cancel" bindtap="closeSharePanel">取消</view>
    </view>
  </view>
</block>

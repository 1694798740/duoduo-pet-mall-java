<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="fetchDetail">重试</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:elif="{{detail}}">
  <!-- 商品图集：统一 1:1 出图，点击可全屏预览 -->
  <view class="card p-media">
    <swiper
      class="p-swiper"
      indicator-dots="{{detail.gallery.length > 1}}"
      indicator-color="rgba(35,38,47,0.15)"
      indicator-active-color="#4f6ef7"
      circular="{{detail.gallery.length > 1}}"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{detail.gallery}}" wx:key="*this">
        <image
          class="p-swiper-img"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="previewImage"
          lazy-load
        />
      </swiper-item>
    </swiper>
    <view wx:if="{{detail.gallery.length > 1}}" class="p-thumbs">
      <image
        wx:for="{{detail.gallery}}"
        wx:key="*this"
        class="p-thumb {{swiperIndex === index ? 'p-thumb-on' : ''}}"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
      />
    </view>
  </view>

  <view class="card">
    <view class="p-title">{{detail.title}}</view>
    <view wx:if="{{detail.subtitle}}" class="t3">{{detail.subtitle}}</view>
    <view class="p-price-row">
      <view class="price p-price">{{detail.minPriceText}}</view>
      <view class="t3">已售 {{detail.salesCount}}</view>
      <view class="tag tag-brand" bindtap="askAi">🤖 问问 AI</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">选择规格</view>
    <view wx:if="{{detail.skus.length === 0}}" class="t3">该商品暂无可售规格</view>
    <view wx:else class="sku-list">
      <view
        wx:for="{{detail.skus}}"
        wx:key="id"
        class="sku {{index === selectedSkuIndex ? 'sku-active' : ''}} {{item.stock <= 0 || !item.sellable ? 'sku-disabled' : ''}}"
        data-index="{{index}}"
        bindtap="selectSku"
      >
        <image class="sku-thumb" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
        <text class="sku-text">{{item.specText}}</text>
        <text class="sku-price">¥{{item.priceText}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">用户评价{{reviewSummary && reviewSummary.total > 0 ? '（' + reviewSummary.total + '）' : ''}}</view>
    <view wx:if="{{reviews.length === 0}}" class="t3">暂无评价</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-item">
      <view class="review-head">
        <text class="t2">{{item.nickname || '匿名用户'}}</text>
        <text class="t3">{{item.rating || 5}} 星</text>
      </view>
      <view class="review-content">{{item.content}}</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">商品介绍</view>
    <text class="p-desc">{{detail.description || '暂无介绍'}}</text>
  </view>

  <view style="height: 140rpx"></view>
  <view class="footer">
    <button class="btn btn-plain footer-share" open-type="share" size="mini">分享</button>
    <button
      class="btn btn-accent footer-btn"
      bindtap="addCart"
      disabled="{{adding || detail.skus.length === 0}}"
      loading="{{adding}}"
    >
      加入购物车
    </button>
  </view>
</block>

<nav-bar title="我的多多币" />

<view wx:if="{{loading}}" class="empty">正在加载…</view>
<view wx:elif="{{error}}" class="empty">{{error}}</view>

<block wx:else>
  <view wx:if="{{campaign}}" class="campaign">
    <view class="campaign-title">{{campaign.name}} 进行中</view>
    <view class="t3">签到 {{campaign.signinMultiplier}} 倍 · 返币 {{campaign.earnMultiplier}} 倍 · 至 {{campaign.endText}}</view>
  </view>

  <view class="hero">
    <view class="t3">当前可用</view>
    <view class="balance">{{account.balance || 0}}<text class="unit">币</text></view>
    <view class="hero-sub">
      累计获得 {{account.totalEarned || 0}} · 累计消耗 {{account.totalSpent || 0}}
    </view>
    <view wx:if="{{account.expiringSoonCoins > 0}}" class="warn">
      30 天内到期 {{account.expiringSoonCoins}} 币
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">每日签到</text>
      <text class="t3">{{signinMonth.continuousDays > 0 ? '已连签 ' + signinMonth.continuousDays + ' 天' : '每天 5 币'}}</text>
    </view>
    <button class="btn {{signedToday ? 'btn-plain' : 'btn-primary'}}" disabled="{{signedToday || signinBusy}}" bindtap="signin">
      {{signedToday ? '今日已签到' : signinBusy ? '签到中…' : '签到领币 +5'}}
    </button>
    <view class="t3 tip">连签 3 天当天额外 +10，连签 7 天额外 +30；断签重新计算。</view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">任务中心</text>
      <text class="t3">达成即自动发币</text>
    </view>
    <view class="sub-title">每日任务</view>
    <view wx:for="{{dailyTasks}}" wx:key="code" class="task">
      <view class="row-between">
        <view>
          <view class="task-name">{{item.name}}<text class="t3"> +{{item.rewardCoins}} 币</text></view>
          <view class="t3">{{item.description}}</view>
        </view>
        <text class="tag">{{item.rewarded ? '已发放' : item.completed ? '已达成' : item.progress + '/' + item.targetCount}}</text>
      </view>
      <view class="bar"><view class="bar-in {{item.rewarded ? 'bar-done' : ''}}" style="width: {{item.percent}}%"></view></view>
    </view>
    <block wx:if="{{newcomerTasks.length}}">
      <view class="sub-title">新人任务（一次性）</view>
      <view wx:for="{{newcomerTasks}}" wx:key="code" class="task">
        <view class="row-between">
          <view>
            <view class="task-name">{{item.name}}<text class="t3"> +{{item.rewardCoins}} 币</text></view>
            <view class="t3">{{item.description}}</view>
          </view>
          <text class="tag">{{item.rewarded ? '已发放' : item.completed ? '已达成' : item.progress + '/' + item.targetCount}}</text>
        </view>
        <view class="bar"><view class="bar-in {{item.rewarded ? 'bar-done' : ''}}" style="width: {{item.percent}}%"></view></view>
      </view>
    </block>
    <view class="t3 tip">浏览商品 / 分享满 15 / 10 秒自动计数；收藏、加购、发布、评价由对应页面触发。</view>
  </view>

  <view wx:if="{{account.expiringLots.length}}" class="card">
    <view class="card-title">30 天内到期</view>
    <view wx:for="{{account.expiringLots}}" wx:key="lotId" class="row-between task">
      <text class="t3">{{item.expireAt}}</text>
      <text class="warn">{{item.coins}} 币</text>
    </view>
  </view>
</block>

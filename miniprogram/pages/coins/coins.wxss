.empty { padding: 80rpx 40rpx; text-align: center; color: var(--t3); }
.hero { margin: 24rpx; padding: 40rpx 24rpx; border-radius: 20rpx; background: var(--card); text-align: center; }
.balance { font-size: 80rpx; font-weight: 700; color: var(--brand); line-height: 1.2; }
.unit { font-size: 26rpx; color: var(--t3); margin-left: 8rpx; }
.hero-sub { font-size: 24rpx; color: var(--t3); margin-top: 12rpx; }
.warn { color: #e5484d; font-size: 24rpx; margin-top: 10rpx; }
.campaign { margin: 24rpx; padding: 24rpx; border-radius: 16rpx; background: rgba(255, 92, 92, 0.1); }
.campaign-title { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.card { margin: 24rpx; padding: 24rpx; border-radius: 20rpx; background: var(--card); }
.card-title { font-size: 30rpx; font-weight: 600; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
.t3 { color: var(--t3); font-size: 24rpx; }
.btn { margin-top: 20rpx; width: 100%; }
.tip { margin-top: 16rpx; line-height: 1.5; }
.sub-title { font-size: 24rpx; color: var(--t3); margin: 24rpx 0 8rpx; font-weight: 600; }
.task { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.task-name { font-size: 28rpx; font-weight: 600; }
.tag { font-size: 22rpx; color: var(--brand); border: 1rpx solid var(--brand); border-radius: 8rpx; padding: 2rpx 8rpx; }
.bar { height: 8rpx; background: var(--line); border-radius: 4rpx; overflow: hidden; margin-top: 10rpx; }
.bar-in { height: 100%; background: var(--brand); }
.bar-done { background: #16a34a; }

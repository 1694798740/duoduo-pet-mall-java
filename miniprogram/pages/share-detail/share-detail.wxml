<nav-bar title="分享详情" back="{{true}}" />

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="goShareCircle">去分享圈逛逛</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:elif="{{view}}">
  <!-- 好友直转：无分享单，只有一句转达语 -->
  <view wx:if="{{friendShare}}" class="sd-intro">
    <text class="sd-intro-icon">🎁</text>
    <text>好友向你分享了这个商品</text>
  </view>

  <!-- 分享者信息（分享圈发布的内容才带）：第四十六轮起转发时这里是**转发人本人** -->
  <view wx:else class="card sd-user">
    <image class="sd-avatar" src="{{view.avatar || '/images/category/default.png'}}" mode="aspectFill" />
      <view class="sd-user-info">
      <view class="t2">{{view.nickname}}</view>
      <view class="t3">
        {{view.shareType === 'REPOST' ? '转发了一条分享' : '觉得这个商品不错'}} · {{view.timeText}}{{view.edited ? ' · 已编辑' : ''}}
      </view>
    </view>
  </view>

  <!-- 本条分享作者自己的话：原创 = 评价，转发 = 附言（可为空） -->
  <view wx:if="{{view.content}}" class="card">
    <view class="sd-quote">{{view.content}}</view>
  </view>

  <!-- 话题标签（第五十六轮）：点进话题聚合页；容器 align-items:center 保证胶囊不被拉伸 -->
  <view wx:if="{{view.topics.length}}" class="sd-topics">
    <text
      wx:for="{{view.topics}}"
      wx:key="*this"
      class="sd-topic"
      data-name="{{item}}"
      bindtap="goTopic"
    >#{{item}}</text>
  </view>

  <!-- 转发引自原帖：署名原作者 + 引出原评价（第四十六轮；第五十六轮支持原帖已删除） -->
  <view wx:if="{{view.shareType === 'REPOST'}}" class="card sd-ref">
    <view class="sd-ref-hd">转发自 @{{view.parentNickname}}</view>
    <view wx:if="{{view.parentDeleted}}" class="sd-ref-body t3">原内容已被作者删除</view>
    <view wx:elif="{{view.parentContent}}" class="sd-ref-body">{{view.parentContent}}</view>
    <view wx:else class="sd-ref-body t3">（原分享没有写评价）</view>
  </view>

  <!-- 商品卡：点击进详情 -->
  <view class="card sd-product" bindtap="goProduct">
    <image class="sd-img" src="{{view.image}}" mode="aspectFill" lazy-load />
    <view class="sd-p-info">
      <view class="sd-p-title">{{view.productTitle}}</view>
      <view class="price">¥{{view.priceText}}</view>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="sd-actions">
    <button class="btn btn-accent sd-act-btn" bindtap="goProduct">查看商品</button>
    <button class="btn btn-plain sd-act-btn" bindtap="openForward">转发到分享圈</button>
  </view>
  <view class="sd-link" bindtap="goShareCircle">逛逛分享圈 ›</view>
  <!-- 举报只对**他人**的内容显示：自己的内容该走「我的分享」里的删除（后端也会拒 422） -->
  <view wx:if="{{!friendShare && !view.mine}}" class="sd-report" bindtap="openReport">举报这条分享</view>

  <!-- 评论区（第五十六轮）：好友直转的商品卡没有分享单，没有评论区 -->
  <view wx:if="{{!friendShare}}" class="card sd-comments">
    <view class="sd-c-title">评论 {{view.commentCount || 0}}</view>
    <view wx:if="{{!comments.length}}" class="sd-c-empty t3">
      {{commentLoading ? '加载中…' : '还没有评论，来说两句'}}
    </view>
    <view wx:for="{{comments}}" wx:key="id" class="sd-c-item">
      <image
        class="sd-c-avatar"
        src="{{item.avatar || '/images/category/default.png'}}"
        mode="aspectFill"
      />
      <view class="sd-c-main">
        <view class="sd-c-hd">
          <text class="sd-c-name">{{item.nickname}}</text>
          <text wx:if="{{item.mine}}" class="sd-c-me">我</text>
        </view>
        <view class="sd-c-body">{{item.content}}</view>
        <view class="sd-c-meta">
          <text class="t3">{{item.timeText}}</text>
          <text class="sd-c-act" data-index="{{index}}" bindtap="openReply">回复</text>
          <text
            class="sd-c-act sd-c-like {{item.liked ? 'on' : ''}}"
            data-index="{{index}}"
            bindtap="toggleCommentLike"
          >♥ {{item.likeCount || 0}}</text>
        </view>
        <view
          wx:if="{{item.replyCount}}"
          class="sd-c-more"
          data-index="{{index}}"
          bindtap="toggleReplies"
        >{{item.expanded ? '收起回复' : '展开 ' + item.replyCount + ' 条回复'}}</view>
        <view wx:if="{{item.expanded}}" class="sd-c-replies">
          <view wx:for="{{item.replies}}" wx:for-item="rep" wx:key="id" class="sd-c-reply">
            <text class="sd-c-name">{{rep.nickname}}</text>
            <text class="t3"> 回复 @{{rep.replyToNickname}}：</text>
            <text class="sd-c-reply-txt">{{rep.content}}</text>
          </view>
        </view>
      </view>
    </view>
    <view
      wx:if="{{comments.length && !commentNoMore}}"
      class="sd-c-more-more"
      bindtap="loadMoreComments"
    >{{commentLoading ? '加载中…' : '加载更多评论'}}</view>
  </view>
  <view wx:if="{{!friendShare}}" class="sd-cbar-pad"></view>
</block>

<!-- 评论输入条（第五十六轮）：固定在底部，页面尾部用 .sd-cbar-pad 留出等高空位 -->
<view wx:if="{{!friendShare && view}}" class="sd-cbar">
  <view wx:if="{{replyTo}}" class="sd-cbar-to">
    <text>回复 @{{replyTo.nickname}}</text>
    <text class="sd-cbar-x" bindtap="cancelReply">×</text>
  </view>
  <view class="sd-cbar-row">
    <input
      class="sd-cbar-input"
      value="{{commentInput}}"
      bindinput="onCommentInput"
      maxlength="300"
      confirm-type="send"
      bindconfirm="submitComment"
      placeholder="{{replyTo ? '回复 @' + replyTo.nickname : '说点什么…'}}"
      placeholder-class="sd-c-ph"
    />
    <button
      class="btn btn-accent sd-cbar-btn"
      loading="{{sendingComment}}"
      disabled="{{sendingComment}}"
      bindtap="submitComment"
    >发送</button>
  </view>
</view>

<!-- 举报弹层（第五十六轮）：理由是预置项，选一个即提交 -->
<view wx:if="{{reportPanel}}" class="sd-mask" bindtap="closeReport">
  <view class="sd-panel" catchtap="noop">
    <view class="sd-panel-title">举报这条分享</view>
    <view class="sd-panel-sub t3">请选择举报理由，平台会尽快处理</view>
    <view class="sd-report-list">
      <view
        wx:for="{{reportReasons}}"
        wx:key="*this"
        class="sd-report-item"
        data-index="{{index}}"
        bindtap="pickReport"
      >{{item}}</view>
    </view>
    <view class="sd-panel-cancel" bindtap="closeReport">取消</view>
  </view>
</view>

<!-- 转发弹层（第四十六轮）：与分享圈同一套交互 -->
<view wx:if="{{sharePanel}}" class="sd-mask" bindtap="closeForward">
  <view class="sd-panel" catchtap="noop">
    <view class="sd-panel-title">转发这条分享</view>
    <view class="sd-panel-sub t3">转发自 @{{view.parentNickname || view.nickname}}</view>
    <textarea
      class="sd-panel-input"
      value="{{repostContent}}"
      bindinput="onRepostInput"
      maxlength="500"
      placeholder="说点什么…（选填）"
      placeholder-class="sd-panel-ph"
    />
    <view class="sd-panel-actions">
      <button class="btn btn-plain sd-panel-btn" open-type="share">
        分享给好友
      </button>
      <button
        class="btn btn-accent sd-panel-btn"
        loading="{{reposting}}"
        disabled="{{reposting}}"
        bindtap="repostToCircle"
      >
        转发到分享圈
      </button>
    </view>
    <view class="sd-panel-cancel" bindtap="closeForward">取消</view>
  </view>
</view>

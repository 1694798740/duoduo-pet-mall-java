/* ── 发布闲置（第五十二轮） ── */
.fp { padding-bottom: 60rpx; }

/* 实名预检引导卡（第五十二轮热修）：未实名时替代表单显示 */
.fp-gate {
  margin: 32rpx 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}
.fp-gate-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.fp-gate-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1, var(--text));
  margin-bottom: 14rpx;
}
.fp-gate-text {
  font-size: 26rpx;
  color: var(--text-2, var(--text-2));
  line-height: 1.7;
  margin-bottom: 32rpx;
}
.fp-gate-btn { margin: 0 auto; width: 60%; }

.fp-tip {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.fp-field { margin-bottom: 28rpx; }
.fp-field:last-child { margin-bottom: 0; }
.fp-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.fp-req { color: var(--accent); margin-left: 4rpx; }

.fp-input,
.fp-textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
}
.fp-input { height: 84rpx; }
.fp-textarea { height: 200rpx; }
.fp-ph { color: var(--text-3); font-size: 27rpx; }
.fp-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.fp-row { display: flex; gap: 20rpx; }
.fp-half { flex: 1; min-width: 0; }

.fp-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.fp-chip {
  padding: 12rpx 28rpx;
  background: var(--bg);
  color: var(--text-2);
  border-radius: 30rpx;
  font-size: 26rpx;
}
.fp-chip-on {
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 600;
}

.fp-error {
  margin: 0 24rpx 20rpx;
  padding: 18rpx 22rpx;
  background: var(--accent-weak);
  color: var(--accent);
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 编辑模式读取回填中的占位（第五十三轮） */
.fp-edit-loading {
  margin: 0 24rpx 20rpx;
  padding: 40rpx 22rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.fp-actions {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 24rpx 0;
}
.fp-actions .btn { flex: 1; }
.fp-btn-cancel { background: var(--card); color: var(--text-2); }
.fp-btn-submit { flex: 1.6; }

.sec-title {
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* 已提交售后的展示 */
.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.existing-reason {
  font-size: 25rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 售后类型选择 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.type-item {
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.type-on {
  border-color: var(--brand);
  background: var(--brand-weak);
}
.type-label {
  font-size: 29rpx;
  font-weight: 600;
}
.type-on .type-label {
  color: var(--brand);
}
.type-desc {
  font-size: 23rpx;
  margin-top: 6rpx;
}

/* 诉求输入 */
.reason-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 220rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
}
.reason-count {
  text-align: right;
  font-size: 22rpx;
  margin-top: 8rpx;
}
.reason-tip {
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.footer-btn {
  width: 100%;
  height: 80rpx;
}

<view wx:if="{{error}}" class="error-box">{{error}}</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:else>
  <!-- 已提交的售后：同类型不能重复，不同类型还能再提，所以列出来而不是一刀切挡住 -->
  <view wx:if="{{existingList.length > 0}}" class="card">
    <view class="sec-title">该订单已提交的售后</view>
    <view wx:for="{{existingList}}" wx:key="id" class="existing-item">
      <view class="kv-row">
        <text class="t2">{{item.typeLabel || item.type}}</text>
        <text class="tag tag-accent">{{item.statusLabel || item.status}}</text>
      </view>
      <view wx:if="{{item.reason}}" class="t3 existing-reason">{{item.reason}}</view>
      <view wx:if="{{item.sellerReply}}" class="t3 existing-reason">卖家回复：{{item.sellerReply}}</view>
    </view>
    <view wx:if="{{remainingTypes.length === 0}}" class="t3 card-tip">
      两种售后类型都已提交，如需跟进请留意上方进度
    </view>
  </view>

  <block wx:if="{{remainingTypes.length > 0}}">
    <view wx:if="{{existingList.length > 0}}" class="t3 card-tip">
      每种售后类型同一订单只能提交一次，你还可以申请另一种类型
    </view>

    <view class="card">
      <view class="sec-title">订单号</view>
      <view class="t2">{{orderNo}}</view>
    </view>

    <view class="card">
      <view class="sec-title">售后类型</view>
      <view class="type-list">
        <view
          wx:for="{{remainingTypes}}"
          wx:key="key"
          class="type-item {{type === item.key ? 'type-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickType"
        >
          <view class="type-label">{{item.label}}</view>
          <view class="t3 type-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="sec-title">售后诉求</view>
      <textarea
        class="reason-input"
        maxlength="{{reasonMax}}"
        placeholder="请说明遇到的问题，例如商品破损、与描述不符等（最多 500 字）"
        value="{{reason}}"
        bindinput="onReason"
      />
      <view class="t3 reason-count">{{reason.length}}/{{reasonMax}}</view>
    </view>

    <view class="card">
      <view class="sec-title">举证图片（选填，最多 {{imagesMax}} 张）</view>
      <view class="img-grid">
        <view wx:for="{{images}}" wx:key="index" class="img-cell">
          <image
            class="img-thumb"
            src="{{item.url || item.path}}"
            mode="aspectFill"
            data-src="{{item.url}}"
            bindtap="previewImage"
          />
          <view wx:if="{{item.failed}}" class="img-uploading img-failed">上传失败</view>
          <view wx:elif="{{!item.url}}" class="img-uploading">上传中</view>
          <view class="img-del" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
        <view wx:if="{{images.length < imagesMax}}" class="img-cell img-add" bindtap="addImage">＋</view>
      </view>
      <view class="t3 reason-tip">照片要能看清问题，卖家处理时会参考</view>
    </view>

    <view style="height: 140rpx"></view>
    <view class="footer">
      <button
        class="btn btn-accent footer-btn"
        bindtap="submit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >提交售后申请</button>
    </view>
  </block>
</block>

/* 分类页：左右分栏，整页不滚动（列表在右侧 scroll-view 内滚动）
   高度用 position:fixed + 四向 0 撑满**可见视口**（自动扣掉 tabBar 与安全区），
   比 height:100vh 可靠：vh 是屏幕高，会把最后一行压到 tabBar 下面 */

.cat-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  background: var(--bg);
}

/* ── 左栏：固定宽度且**不允许被压缩**（flex: none）
   此前只写了 width，没有禁止收缩：右侧固定宽卡片一撑，左栏就被挤窄 → 分类名逐字竖排 */
.cat-side {
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 100%;
  background: #fff;
}

/* 每一项：图标 + 单行文案；左内边距与选中态左条对齐，切换时文字不跳动 */
.cat-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 12rpx 26rpx 14rpx;
  font-size: 25rpx;
  color: var(--text-2);
  border-left: 6rpx solid transparent;
  white-space: nowrap;   /* 关键：禁止逐字换行 */
  overflow: hidden;
}
.cat-item-icon {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border-radius: 10rpx;
  background: var(--bg);
}
.cat-item-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选中态：浅蓝底 + 蓝色左条 + 主色加粗 —— 所有分类共用同一套规则 */
.cat-active {
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 700;
  border-left-color: var(--brand);
}

/* ── 右栏 */
.cat-main {
  flex: 1;
  /* 关键：flex 子项默认 min-width:auto —— 会被内部长商品名"顶宽"，
     导致整个右栏连同卡片一起超出屏幕（表现为标题溢到屏幕外、卡片右边缘看不见）。
     min-width:0 才允许它收缩到分配宽度，配合 .cg-body 的 min-width:0 + 两行省略号完成截断。 */
  min-width: 0;
  height: 100%;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.cat-children {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 22rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin-right: 12rpx;
}
.chip-icon {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  border-radius: 8rpx;
}
.chip-active {
  background: var(--brand);
  color: #fff;
}

/* ── 商品列表：单列横向卡 ──────────────────────────────────────
   **刻意不复用全局 .goods-***：全局 `.goods-card` 是固定 340rpx 的双列基线，
   而本页左栏占 200rpx —— 340×2 + 200 = 880rpx 已超出 750rpx 屏宽，
   一旦页面级的宽度覆盖失效（样式缓存、编译顺序、后续有人改了全局类），
   右列就会被挤出屏幕、封面被放大到 340rpx（表现为「图标过大、超出屏幕」）。
   自带一套类名 = 与全局解耦，任何全局改动都不会再影响这一页。

   宽度全部交给 flex（不写百分比/固定 rpx），单列天然占满一行，不可能横向溢出。 */
.cg-grid {
  display: block;
  padding: 0;
}
.cg-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  max-width: 100%;        /* 兜底：绝不超出容器宽度 */
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: 0 2rpx 12rpx rgba(35, 38, 47, 0.04);
  overflow: hidden;   /* 兜底：任何内容都不越出圆角卡片 */
}
.cg-cover {
  flex: none;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--brand-weak);
}
.cg-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cg-body {
  flex: 1;
  /* flex 子项默认 min-width:auto，长标题会把整行撑破 → 必须显式压到 0 */
  min-width: 0;
}
.cg-name {
  font-size: 27rpx;
  line-height: 38rpx;
  color: var(--text);
  /* 长英文/连续数字（如「85g×12罐」「K36」）也能断行，配合 .ellipsis-2 两行省略 */
  word-break: break-word;
  overflow-wrap: break-word;
}
.cg-price {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent);
}
.cg-price::before {
  content: '¥';
  font-size: 22rpx;
}

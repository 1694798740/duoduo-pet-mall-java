<view class="cat-wrap">
  <!-- 左栏：固定宽度不收缩，每项「图标 + 单行文案」，选中态全部分类一致 -->
  <scroll-view scroll-y class="cat-side">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-item {{index === activeIndex ? 'cat-active' : ''}}"
      data-index="{{index}}"
      bindtap="selectMain"
    >
      <image class="cat-item-icon" src="{{item.iconSrc}}" mode="aspectFit" lazy-load />
      <text class="cat-item-text">{{item.name}}</text>
    </view>
  </scroll-view>

  <scroll-view
    scroll-y
    class="cat-main"
    lower-threshold="120"
    bindscrolltolower="onScrollToLower"
  >
    <!-- 子分类 chips：同样带图标，选中态与左栏同一套配色 -->
    <scroll-view scroll-x wx:if="{{activeChildren.length > 0}}" class="cat-children">
      <view
        class="cat-chip {{activeChildId === '' ? 'chip-active' : ''}}"
        data-id=""
        bindtap="selectChild"
      >
        <image class="chip-icon" src="/images/category/default.png" mode="aspectFit" />
        <text>全部</text>
      </view>
      <view
        wx:for="{{activeChildren}}"
        wx:key="id"
        class="cat-chip {{activeChildId === item.id ? 'chip-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectChild"
      >
        <image class="chip-icon" src="{{item.iconSrc}}" mode="aspectFit" />
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <view wx:if="{{error}}" class="error-box">
      <view>{{error}}</view>
      <button class="btn btn-plain btn-mini" bindtap="fetchCategories">重试</button>
    </view>
    <view wx:elif="{{loading && items.length === 0}}" class="empty">加载中…</view>
    <view wx:elif="{{items.length === 0}}" class="empty">
      <view class="icon">🛍️</view>
      <view>该分类下暂无商品</view>
    </view>

    <view wx:else class="goods-grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="goods-card"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="goods-cover">
          <image src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
        </view>
        <view class="goods-body">
          <view class="goods-name ellipsis-2">{{item.title}}</view>
          <view class="price goods-price">{{item.priceText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && items.length > 0}}" class="empty">加载更多…</view>
    <view wx:elif="{{!hasMore && items.length > 0}}" class="empty">— 已经到底啦 —</view>
  </scroll-view>
</view>

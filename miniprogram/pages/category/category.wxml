<view class="cat-wrap">
  <scroll-view scroll-y class="cat-side">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-item {{index === activeIndex ? 'cat-active' : ''}}"
      data-index="{{index}}"
      bindtap="selectMain"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 列表在 scroll-view 内滚动：分页必须靠 bindscrolltolower（页面级 onReachBottom 不会触发） -->
  <scroll-view
    scroll-y
    class="cat-main"
    lower-threshold="120"
    bindscrolltolower="onScrollToLower"
  >
    <scroll-view scroll-x wx:if="{{activeChildren.length > 0}}" class="cat-children">
      <view
        class="cat-chip {{activeChildId === '' ? 'chip-active' : ''}}"
        data-id=""
        bindtap="selectChild"
      >全部</view>
      <view
        wx:for="{{activeChildren}}"
        wx:key="id"
        class="cat-chip {{activeChildId === item.id ? 'chip-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectChild"
      >{{item.name}}</view>
    </scroll-view>

    <view wx:if="{{error}}" class="error-box">
      <view>{{error}}</view>
      <button class="btn btn-plain btn-mini" bindtap="fetchCategories">重试</button>
    </view>
    <view wx:elif="{{loading && items.length === 0}}" class="empty">加载中…</view>
    <view wx:elif="{{items.length === 0}}" class="empty">
      <view class="icon">🛍️</view>
      <view>该分类下暂无商品</view>
    </view>

    <view wx:else class="goods-grid" style="padding: 0">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="goods-card"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="goods-cover">
          <image wx:if="{{item.mainImage}}" src="{{item.mainImage}}" mode="aspectFill" lazy-load />
          <text wx:else>🐱</text>
        </view>
        <view class="goods-body">
          <view class="goods-name ellipsis-2">{{item.title}}</view>
          <view class="price goods-price">{{item.priceText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && items.length > 0}}" class="empty">加载更多…</view>
    <view wx:elif="{{!hasMore && items.length > 0}}" class="empty">— 已经到底啦 —</view>
  </scroll-view>
</view>

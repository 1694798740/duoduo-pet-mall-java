/* 结算确认页：结构与购物车结算保持一致（地址行 / 商品行 / 券行 / 金额汇总 / 底部提交） */
.addr-row { display: flex; align-items: center; gap: 16rpx; }
.addr-icon { font-size: 34rpx; }
.addr-body { flex: 1; }
.addr-name { font-size: 28rpx; font-weight: 500; }
.addr-full { margin-top: 6rpx; }
.addr-arrow { color: var(--text-3); font-size: 32rpx; }

.co-item { display: flex; gap: 20rpx; }
.co-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex: none;
  background: var(--bg);
}
.co-main { flex: 1; display: flex; flex-direction: column; }
.co-title { font-size: 28rpx; line-height: 1.4; }
.co-spec { margin-top: 8rpx; }
.co-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.co-invalid { margin-top: 16rpx; color: #e5484d; font-size: 24rpx; }

/* 数量步进器 */
.stepper { display: flex; align-items: center; border: 2rpx solid var(--line); border-radius: 10rpx; overflow: hidden; }
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  color: var(--text-2);
  background: var(--bg);
}
.step-num { min-width: 68rpx; text-align: center; font-size: 26rpx; }

/* 优惠券行 */
.coupon-row { display: flex; align-items: center; gap: 16rpx; }
.cp-icon { font-size: 32rpx; }
.cp-name { flex: 1; font-size: 28rpx; }
.cp-discount { color: var(--accent); font-size: 26rpx; }

/* 金额汇总 */
.co-line { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 27rpx; }
.co-minus { color: var(--accent); }
.co-total { border-top: 1rpx solid var(--line); margin-top: 8rpx; padding-top: 16rpx; font-weight: 600; }

/* 底部提交 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.footer-total { flex: 1; font-size: 28rpx; }
.footer-submit { width: 300rpx; height: 76rpx; margin: 0; }

<scroll-view scroll-x class="order-tabs">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="switchTab"
  >{{item.label}}</view>
</scroll-view>

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button wx:if="{{needLogin}}" class="btn btn-plain btn-mini" bindtap="goLogin">去登录</button>
</view>
<view wx:elif="{{loading && orders.length === 0}}" class="empty">加载中…</view>
<view wx:elif="{{orders.length === 0}}" class="empty">
  <view class="icon">📦</view>
  <view>还没有相关订单</view>
</view>

<view
  wx:for="{{orders}}"
  wx:key="orderNo"
  class="card order-item"
  data-no="{{item.orderNo}}"
  bindtap="goDetail"
>
  <view class="o-head">
    <text class="o-no">单号 {{item.orderNo}}</text>
    <text class="o-status">{{item.statusText}}</text>
  </view>
  <view class="o-body">
    <view wx:for="{{item.items}}" wx:key="skuId" class="o-goods">
      <image class="o-thumb" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
      <view class="o-goods-main">
        <view class="o-goods-title">{{item.title}}</view>
        <view class="t3" wx:if="{{item.specText}}">{{item.specText}}</view>
      </view>
      <text class="t3 o-goods-qty">× {{item.quantity}}</text>
    </view>
    <view wx:if="{{item.moreCount > 0}}" class="t3 o-goods-more">…等共 {{item.quantityText}} 件商品</view>
    <view wx:if="{{item.items.length === 0}}" class="t3">共 {{item.quantityText}} 件商品</view>
    <view class="o-amount">
      <text>实付</text>
      <text class="price">{{item.payAmountText}}</text>
    </view>
  </view>
  <view class="o-actions">
    <button
      wx:if="{{item.status === 'PENDING_PAYMENT'}}"
      class="btn-mini o-btn-plain"
      size="mini"
      data-no="{{item.orderNo}}"
      catchtap="cancelOrder"
    >
      取消订单
    </button>
    <button
      wx:if="{{item.status === 'PENDING_PAYMENT'}}"
      class="btn btn-accent o-btn"
      size="mini"
      data-no="{{item.orderNo}}"
      catchtap="pay"
      loading="{{payingOrderNo === item.orderNo}}"
    >
      去支付
    </button>
    <button
      wx:if="{{item.status === 'SHIPPED'}}"
      class="btn-mini o-btn-plain"
      size="mini"
      data-no="{{item.orderNo}}"
      catchtap="confirmOrder"
    >
      确认收货
    </button>
  </view>
</view>

<view wx:if="{{loading && orders.length > 0}}" class="empty">加载更多…</view>
<view wx:elif="{{!hasMore && orders.length > 0}}" class="empty">— 已经到底啦 —</view>

.o-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.o-no {
  color: #999;
  font-size: 24rpx;
}

.o-status {
  color: #4f6ef7;
  font-size: 26rpx;
}

.o-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.o-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.o-btn {
  width: 180rpx;
}

.o-btn-plain {
  background: #fff;
  border: 2rpx solid #4f6ef7;
  color: #4f6ef7;
  border-radius: 12rpx;
}

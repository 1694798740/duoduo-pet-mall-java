.order-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 12rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-2);
  border-radius: 28rpx;
  margin: 0 6rpx;
}
.tab-active { background: var(--brand-weak); color: var(--brand); font-weight: 700; }
.o-head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.o-no { color: var(--text-3); font-size: 24rpx; }
.o-status { color: var(--brand); font-size: 26rpx; font-weight: 500; }
.o-body { display: flex; flex-direction: column; margin-bottom: 16rpx; }
.o-actions { display: flex; justify-content: flex-end; gap: 16rpx; }
.o-btn { width: 180rpx; height: 60rpx; font-size: 26rpx; }
.o-btn-plain {
  background: #fff;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  border-radius: 28rpx;
}

/* ── 卡片内商品缩略行（第三十七轮） ───────────────────────────── */
.o-goods {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.o-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  flex: 0 0 100rpx;
}
.o-goods-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}
.o-goods-title {
  font-size: 26rpx;
  color: #23262f;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.o-goods-qty {
  flex: 0 0 auto;
}
.o-goods-more {
  margin-bottom: 12rpx;
}
.o-amount {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 12rpx;
  font-size: 26rpx;
  color: #23262f;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(180deg, var(--brand) 0%, var(--brand) 70%, var(--bg) 100%);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.head-info .nick { color: #fff; font-size: 34rpx; font-weight: 700; }
.head-info .t3 { color: rgba(255, 255, 255, 0.75); }
.coupon-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: var(--radius);
  margin: -30rpx 24rpx 0;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.coupon-num { font-size: 40rpx; font-weight: 700; color: var(--accent); }
.menu { padding: 0 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 36rpx; }
.arrow { margin-left: auto; color: var(--text-3); }
.logout-btn { margin: 40rpx 24rpx; }

/* 菜单右侧状态文字（如「微信绑定：已绑定/未绑定」） */
.mi-state {
  margin-left: auto;
  margin-right: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* 右上角私信图标（第四十八轮）：位于 nav-bar 右侧插槽，定位由组件按胶囊实算 */
.nav-msg {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}
.nav-msg-hover {
  opacity: 0.6;
}
.nav-msg-icon {
  font-size: 36rpx;
  line-height: 1;
}

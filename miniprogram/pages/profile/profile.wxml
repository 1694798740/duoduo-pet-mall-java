<nav-bar title="我的" />

<view class="profile-head">
  <view class="avatar">{{logged ? '🐱' : '👤'}}</view>
  <view class="head-info">
    <block wx:if="{{logged}}">
      <view class="nick">{{user.nickname}}</view>
      <view class="t3">{{user.phoneMasked}}</view>
    </block>
    <block wx:else>
      <view class="nick" bindtap="goLogin">点击登录</view>
      <view class="t3">登录后享更多服务</view>
    </block>
  </view>
</view>

<view class="coupon-strip" bindtap="go" data-url="/pages/coupons/coupons?tab=mine">
  <view>
    <view class="coupon-num">{{couponCount}}</view>
    <view class="t3">可用优惠券</view>
  </view>
  <view class="tag tag-accent">去领券 ›</view>
</view>

<view class="card menu">
  <view class="menu-item" bindtap="go" data-url="/pages/coupons/coupons">
    <text class="mi-icon">🎫</text>
    <text>领券中心 / 我的券包</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/ai/ai">
    <text class="mi-icon">🤖</text>
    <text>AI 导购「多多」</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/seckill/seckill">
    <text class="mi-icon">⚡</text>
    <text>限时秒杀</text>
    <text class="arrow">›</text>
  </view>
  <!-- 分享圈（第四十三轮「我的」入口，第四十四轮升为一级 tab 页从这里移出） -->
  <view class="menu-item" bindtap="goAddress">
    <text class="mi-icon">📍</text>
    <text>收货地址</text>
    <text class="arrow">›</text>
  </view>
  <!-- 微信绑定管理：状态来自 UserView.wechatBound（只给布尔，不下发 openid） -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="toggleWechat">
    <text class="mi-icon">🔗</text>
    <text>微信绑定</text>
    <text class="mi-state">{{user.wechatBound ? '已绑定' : '未绑定'}}</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/orders/orders">
    <text class="mi-icon">📦</text>
    <text>我的订单</text>
    <text class="arrow">›</text>
  </view>
  <!-- 社交（第四十七轮）：私信 / 关注与粉丝，接口都要登录态 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/chat-list/chat-list">
    <text class="mi-icon">💬</text>
    <text>私信</text>
    <text class="arrow">›</text>
  </view>
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/follow-list/follow-list">
    <text class="mi-icon">👥</text>
    <text>关注与粉丝</text>
    <text class="arrow">›</text>
  </view>
  <!-- 售后需登录（接口要求令牌），未登录不给入口 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/after-sales/after-sales">
    <text class="mi-icon">🛡️</text>
    <text>我的售后</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/cart/cart">
    <text class="mi-icon">🛒</text>
    <text>购物车</text>
    <text class="arrow">›</text>
  </view>
</view>

<button wx:if="{{logged}}" class="btn btn-plain logout-btn" bindtap="logout">退出登录</button>

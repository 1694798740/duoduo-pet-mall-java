<!-- 第五十轮：右上角通知图标由 nav-bar 组件内置（💬，全页面统一），本页不再用插槽自定义 -->
<nav-bar title="我的" />

<view class="profile-head">
  <view class="avatar">{{logged ? '🐱' : '👤'}}</view>
  <view class="head-info">
    <block wx:if="{{logged}}">
      <view class="nick">{{user.nickname}}</view>
      <view class="t3">{{user.phoneMasked}}</view>
    </block>
    <block wx:else>
      <view class="nick" bindtap="goLogin">点击登录</view>
      <view class="t3">登录后享更多服务</view>
    </block>
  </view>
</view>

<view class="coupon-strip" bindtap="go" data-url="/pages/coupons/coupons?tab=mine">
  <view>
    <view class="coupon-num">{{couponCount}}</view>
    <view class="t3">可用优惠券</view>
  </view>
  <view class="tag tag-accent">去领券 ›</view>
</view>

<view class="card menu">
  <view class="menu-item" bindtap="go" data-url="/pages/coupons/coupons">
    <text class="mi-icon">🎫</text>
    <text>领券中心 / 我的券包</text>
    <text class="arrow">›</text>
  </view>
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/coins/coins">
    <text class="mi-icon">🪙</text>
    <text>我的多多币</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/ai/ai">
    <text class="mi-icon">🤖</text>
    <text>AI 导购「多多」</text>
    <text class="arrow">›</text>
  </view>
  <!-- 问客服直连（A4）：跳到与官方客服账号的私信会话；客服 id 由服务端下发 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="goSupport">
    <text class="mi-icon">💬</text>
    <text>在线客服</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/seckill/seckill">
    <text class="mi-icon">⚡</text>
    <text>限时秒杀</text>
    <text class="arrow">›</text>
  </view>
  <!-- 分享圈（第四十三轮「我的」入口，第四十四轮升为一级 tab 页从这里移出） -->
  <view class="menu-item" bindtap="goAddress">
    <text class="mi-icon">📍</text>
    <text>收货地址</text>
    <text class="arrow">›</text>
  </view>
  <!-- 微信绑定管理：状态来自 UserView.wechatBound（只给布尔，不下发 openid） -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="toggleWechat">
    <text class="mi-icon">🔗</text>
    <text>微信绑定</text>
    <text class="mi-state">{{user.wechatBound ? '已绑定' : '未绑定'}}</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/orders/orders">
    <text class="mi-icon">📦</text>
    <text>我的订单</text>
    <text class="arrow">›</text>
  </view>
  <!-- 我的闲置（第五十二轮）：C2C 发布链路的个人侧入口；需登录 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/flea-mine/flea-mine">
    <text class="mi-icon">🧺</text>
    <text>我的闲置</text>
    <text class="arrow">›</text>
  </view>
  <!-- 我的分享（第五十六轮）：自己发过的分享的编辑 / 删除入口。
       分享圈页也有一个入口，但「我的东西」用户第一反应是来这里找。 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/share-mine/share-mine">
    <text class="mi-icon">📝</text>
    <text>我的分享</text>
    <text class="arrow">›</text>
  </view>
  <!-- 宠物档案引导（S6-D2b）：小程序 tabBar 已满 5 项，宠物档案保持网页端独有（D2 已判决"有意不做"）。
       但**不做功能 ≠ 不提这件事**：用户在小程序里找不到"宠物档案"，会以为它不存在。
       这里给一句说明 + 可复制的网页地址，把"没有"变成"在那边"。
       ★ 刻意不占 menu-item 的跳转位（点了跳不过去，反而像坏了）——做成一条静态提示。 -->
  <view wx:if="{{logged}}" class="menu-note">
    <text class="mi-icon">🐾</text>
    <view class="mn-body">
      <text class="mn-title">宠物档案请在网页端管理</text>
      <text class="mn-sub">小程序暂不提供（首页位置有限），登录同一账号即可看到</text>
    </view>
  </view>
  <!-- 实名认证（第五十二轮热修）：发布闲置的前置条件，此前小程序无任何实名入口 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/realname/realname">
    <text class="mi-icon">🪪</text>
    <text>实名认证</text>
    <text class="arrow">›</text>
  </view>
  <!-- 社交（第四十七轮）：关注与粉丝，接口都要登录态；私信入口已上移右上角 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/follow-list/follow-list">
    <text class="mi-icon">👥</text>
    <text>关注与粉丝</text>
    <text class="arrow">›</text>
  </view>
  <!-- 售后需登录（接口要求令牌），未登录不给入口 -->
  <view wx:if="{{logged}}" class="menu-item" bindtap="go" data-url="/pages/after-sales/after-sales">
    <text class="mi-icon">🛡️</text>
    <text>我的售后</text>
    <text class="arrow">›</text>
  </view>
  <view class="menu-item" bindtap="go" data-url="/pages/cart/cart">
    <text class="mi-icon">🛒</text>
    <text>购物车</text>
    <text class="arrow">›</text>
  </view>
</view>

<button wx:if="{{logged}}" class="btn btn-plain logout-btn" bindtap="logout">退出登录</button>
<!-- C7：隐私指引 4.2 已承诺可注销账号，入口必须可见（微信平台规范要求） -->
<view wx:if="{{logged}}" class="delete-account-entry" bindtap="goDeleteAccount">注销账号</view>

<view wx:if="{{error && items.length === 0}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="retry">重试</button>
</view>
<view wx:elif="{{items.length === 0 && !loading}}" class="empty">
  还没有会话，去分享圈找人聊聊，或在商品页「问一问」卖家
</view>

<block wx:else>
  <view
    wx:for="{{items}}"
    wx:key="peerId"
    class="card cl-item"
    data-user="{{item.peerId}}"
    bindtap="goChat"
  >
    <view class="cl-avatar-wrap">
      <image class="cl-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
      <view wx:if="{{item.unread > 0}}" class="cl-badge">{{item.unread > 99 ? '99+' : item.unread}}</view>
    </view>
    <view class="cl-info">
      <view class="cl-row">
        <text class="cl-nick">{{item.nickname}}</text>
        <text class="t3 cl-time">{{item.timeText}}</text>
      </view>
      <view class="t3 cl-preview ellipsis">{{item.preview}}</view>
      <view wx:if="{{item.consulting}}" class="tag tag-brand cl-tag">商品咨询</view>
      <view wx:elif="{{item.mutual}}" class="tag tag-gray cl-tag">互相关注</view>
      <view wx:elif="{{!item.canSend}}" class="tag tag-gray cl-tag">已发送 1 条，等 TA 回复</view>
    </view>
    <text class="cl-arrow">›</text>
  </view>

  <view wx:if="{{noMore && items.length > 0}}" class="t3 cl-end">— 到底啦 —</view>
  <view wx:elif="{{loading}}" class="t3 cl-end">加载中…</view>
  <view style="height: 40rpx"></view>
</block>

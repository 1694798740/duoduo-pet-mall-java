/* ── 闲置详情（第五十二轮） ── */
.fd { padding-bottom: 40rpx; }

.fd-swiper { width: 100%; height: 640rpx; background: var(--card); }
.fd-swiper-img { width: 100%; height: 100%; }

.fd-main { margin-top: 20rpx; }
.fd-price-row { display: flex; align-items: baseline; gap: 14rpx; }
.fd-price { color: var(--accent); font-size: 48rpx; font-weight: 700; }
.fd-original {
  color: var(--text-3);
  font-size: 26rpx;
  text-decoration: line-through;
}
.fd-views { margin-left: auto; font-size: 23rpx; color: var(--text-3); }
/* 「想要」与「浏览」量级意义不同（一个是有意向的人、一个是打开的次数），用强调色区分 */
.fd-wants { font-size: 23rpx; color: var(--accent); }

.fd-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.55;
}

.fd-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.fd-tag {
  padding: 6rpx 18rpx;
  background: var(--bg);
  color: var(--text-2);
  border-radius: 10rpx;
  font-size: 23rpx;
}
.fd-tag-cond { background: var(--brand-weak); color: var(--brand); }

.fd-sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.fd-desc {
  font-size: 27rpx;
  line-height: 1.75;
  color: var(--text-2);
  word-break: break-all;
}

.fd-new-list { display: flex; flex-wrap: wrap; gap: 18rpx; }
.fd-new {
  width: calc((100% - 36rpx) / 3);
  box-sizing: border-box;
}
.fd-new-img {
  width: 100%;
  height: 180rpx;
  border-radius: 12rpx;
  background: var(--bg);
}
.fd-new-title {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: var(--text-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.fd-new-price {
  margin-top: 6rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--accent);
}

.fd-note {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--bg);
  color: var(--text-3);
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

/* ── 卖家信息卡（第五十三轮） ── */
.fd-seller { display: flex; align-items: center; gap: 20rpx; }
.fd-seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg);
  flex-shrink: 0;
}
.fd-seller-info { flex: 1; min-width: 0; }
.fd-seller-name { font-size: 29rpx; font-weight: 600; }
.fd-seller-arrow { color: var(--text-3); font-size: 40rpx; }

/* ── 底部操作栏（第五十三轮） ── */
.fd-foot {
  padding: 28rpx 24rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
/* 底部按钮（第五十三轮热修二）：高度统一、文字不换行、宽度按内容自适应。
   显式声明 padding/font-size，避免吃到小程序 button 默认内边距后把「立即购买」压成两行。 */
.fd-foot-buy { flex: none; height: 76rpx; padding: 0 28rpx; font-size: 28rpx; }
.fd-foot-want { flex: 1; height: 76rpx; padding: 0 28rpx; font-size: 28rpx; }
.fd-owner-hint { flex: 1; }

.fd-state {
  padding: 120rpx 24rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 27rpx;
}
.fd-error { color: var(--accent); }

/* 聊天页：整页 flex 布局（json disableScroll=true），消息区自适应滚动 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ── 头部 ── */
.chat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  flex: none;
}
.chat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  flex: none;
}
.chat-head-info {
  min-width: 0;
}
.chat-nick {
  font-size: 30rpx;
  font-weight: 600;
}

/* ── 消息流 ── */
.chat-body {
  flex: 1;
  height: 0; /* flex 子项滚动的前提：显式 height:0 让 flex:1 接管 */
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.msg-mine {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  flex: none;
  align-self: flex-start;
}
.msg-col {
  max-width: 70%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.msg-mine .msg-col {
  align-items: flex-end;
}

.msg-bubble {
  background: var(--card);
  border-radius: 20rpx;
  border-top-left-radius: 6rpx;
  padding: 16rpx 22rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  word-break: break-all;
  box-shadow: 0 2rpx 8rpx rgba(35, 38, 47, 0.04);
}
.msg-bubble-mine {
  background: var(--brand);
  color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 6rpx;
}
.msg-time {
  margin-top: 6rpx;
  font-size: 20rpx;
}

/* ── 卡片消息 ── */
.msg-card {
  display: flex;
  gap: 14rpx;
  background: var(--card);
  border-radius: 16rpx;
  padding: 14rpx;
  margin-bottom: 10rpx;
  width: 360rpx;
  box-shadow: 0 2rpx 8rpx rgba(35, 38, 47, 0.06);
}
.msg-card-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--brand-weak);
  flex: none;
}
.msg-card-info {
  flex: 1;
  min-width: 0;
}
.msg-card-title {
  font-size: 24rpx;
  line-height: 34rpx;
}
.msg-card-price {
  margin-top: 6rpx;
  font-size: 26rpx;
}

/* ── 提示 / 输入条 ── */
.chat-hint {
  flex: none;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--accent-weak);
  color: var(--accent);
  padding: 12rpx 24rpx;
}
.chat-input-bar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}
.chat-ph {
  color: var(--text-3);
}
.chat-send {
  width: 132rpx;
  height: 72rpx;
  flex: none;
  margin: 0;
}

/* B 批：媒体气泡与「+」按钮 */
.chat-plus {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f2f6;
  color: #5b6070;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 12rpx;
}
.msg-media {
  width: 360rpx;
  max-height: 420rpx;
  border-radius: 16rpx;
  background: #f1f2f6;
}

/* ── 表情 / 贴纸面板（2026-10-23 · 与 Web 对齐） ── */
.emoji-btn {
  font-size: 32rpx;
}
.emoji-panel {
  flex: none;
  background: var(--card);
  border-top: 1rpx solid #eef0f5;
  padding: 8rpx 0 calc(8rpx + env(safe-area-inset-bottom));
}
.emoji-tabs {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 24rpx 12rpx;
}
.emoji-tab {
  font-size: 24rpx;
  color: #8b90a0;
  padding: 6rpx 4rpx;
  border-bottom: 4rpx solid transparent;
}
.emoji-tab.on {
  color: #3d4353;
  font-weight: 600;
  border-bottom-color: #ff7a45;
}
.emoji-scroll {
  height: 320rpx;
}
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.emoji-cell {
  width: 12.5%;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.sticker-grid {
  padding: 8rpx 16rpx;
}
.sticker-cell {
  width: 25%;
  height: 132rpx;
  padding: 8rpx;
  box-sizing: border-box;
}
/* 逐条「未读」：纯文字 + 琥珀色，与 Web 端一致 */
.msg-unread {
  color: #b26a00;
}

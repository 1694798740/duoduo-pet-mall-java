<nav-bar title="聊天" back="{{true}}" />

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="retry">重试</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>

<block wx:elif="{{page}}">
  <view class="chat-page" style="height: calc(100vh - {{navTotal}}px)">
    <!-- 会话头部：对方资料 + 关系徽章（consulting 优先：咨询会话恒可发） -->
    <view class="chat-head">
      <image class="chat-avatar" src="{{page.peerAvatar || '/images/category/default.png'}}" mode="aspectFill" />
      <view class="chat-head-info">
        <view class="chat-nick">{{page.peerNickname}}</view>
        <view class="t3">
          {{page.consulting ? '商品咨询 · 可自由沟通' : (page.mutual ? '互相关注' : '未互相关注')}}
        </view>
      </view>
    </view>

    <!-- 消息流：时间正序，新消息自动滚底 -->
    <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view wx:if="{{items.length === 0}}" class="empty">
        {{ask ? (listingId ? '向卖家咨询这件闲置吧' : '向卖家咨询这个商品吧') : '打个招呼吧'}}
      </view>
      <view
        wx:for="{{items}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg-row {{item.mine ? 'msg-mine' : ''}}"
      >
        <image
          wx:if="{{!item.mine}}"
          class="msg-avatar"
          src="{{page.peerAvatar || '/images/category/default.png'}}"
          mode="aspectFill"
        />
        <view class="msg-col">
          <!-- 卡片消息：服务端取事实源渲染，点击按类型分流（闲置卡→闲置详情 / 商品卡→商城详情） -->
          <view
            wx:if="{{item.card}}"
            class="msg-card"
            data-spu="{{item.card.id}}"
            data-msgid="{{item.id}}"
            catchtap="goCard"
          >
            <image class="msg-card-img" src="{{item.cardImage}}" mode="aspectFill" />
            <view class="msg-card-info">
              <view class="msg-card-title ellipsis-2">{{item.card.title}}</view>
              <view wx:if="{{item.cardPriceText}}" class="price msg-card-price">{{item.cardPriceText}}</view>
            </view>
          </view>
          <image
            wx:if="{{item.bizType === 'IMAGE'}}"
            class="msg-media"
            src="{{item.mediaUrl}}"
            mode="widthFix"
            data-url="{{item.mediaUrl}}"
            bindtap="previewImage"
          />
          <video
            wx:elif="{{item.bizType === 'VIDEO'}}"
            class="msg-media"
            src="{{item.mediaUrl}}"
            poster="{{item.thumbUrl}}"
            object-fit="contain"
          />
          <view wx:else class="msg-bubble {{item.mine ? 'msg-bubble-mine' : ''}}">{{item.content}}</view>
          <view class="t3 msg-time">{{item.timeText}}<text wx:if="{{item.mine && !item.read}}" class="msg-unread"> · 未读</text></view>
        </view>
      </view>
      <view style="height: 20rpx"></view>
    </scroll-view>

    <!-- 规则提示：非互关且已发过一条时禁言 -->
    <view wx:if="{{hint}}" class="chat-hint">{{hint}}</view>

    <!-- 输入条 -->
    <view class="chat-input-bar">
      <view class="chat-plus emoji-btn" bindtap="toggleEmoji">😀</view>
      <view class="chat-plus" bindtap="pickMedia">＋</view>
      <input
        class="chat-input"
        value="{{input}}"
        placeholder="{{ask ? '想了解什么？直接问卖家…' : '说点什么…'}}"
        placeholder-class="chat-ph"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="send"
        disabled="{{!canSend}}"
      />
      <button
        class="btn btn-accent chat-send"
        size="mini"
        bindtap="send"
        disabled="{{!canSend || sending || !input}}"
        loading="{{sending}}"
      >
        发送
      </button>
    </view>

    <!-- 表情 / 贴纸面板：与 Web、客服页同一清单（56 + 12） -->
    <view wx:if="{{emojiOpen}}" class="emoji-panel">
      <view class="emoji-tabs">
        <view class="emoji-tab {{emojiTab === 'emoji' ? 'on' : ''}}" data-tab="emoji" bindtap="switchEmojiTab">表情</view>
        <view wx:if="{{stickers.length}}" class="emoji-tab {{emojiTab === 'sticker' ? 'on' : ''}}" data-tab="sticker" bindtap="switchEmojiTab">贴纸</view>
      </view>
      <scroll-view scroll-y class="emoji-scroll">
        <view wx:if="{{emojiTab === 'emoji'}}" class="emoji-grid">
          <view wx:for="{{emojis}}" wx:key="*this" class="emoji-cell" data-e="{{item}}" bindtap="pickEmoji">{{item}}</view>
        </view>
        <view wx:else class="emoji-grid sticker-grid">
          <image
            wx:for="{{stickers}}"
            wx:key="*this"
            class="sticker-cell"
            src="{{item}}"
            mode="aspectFit"
            data-url="{{item}}"
            bindtap="pickSticker"
          />
        </view>
      </scroll-view>
    </view>
  </view>
</block>

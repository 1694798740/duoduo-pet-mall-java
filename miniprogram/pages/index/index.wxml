<nav-bar title="多多宠物商店" loading="{{refreshing}}" />

<view class="search-bar">
  <input
    class="search-input"
    placeholder="搜索宠物用品"
    value="{{keyword}}"
    confirm-type="search"
    bindinput="onKeywordInput"
    bindconfirm="onSearch"
  />
  <button class="btn btn-primary search-btn" size="mini" bindtap="onSearch">搜索</button>
</view>

<!-- ── 首页轮播（Banner）：自动轮播 + 手势滑动 + 左右箭头 + 自绘指示器 ──
     内容来自 config/banners.js 的配置数组，增删图片只改配置 -->
<view wx:if="{{banners.length > 0}}" class="banner">
  <swiper
    class="banner-swiper"
    autoplay="{{bannerAutoplay}}"
    interval="{{bannerInterval}}"
    duration="{{bannerDuration}}"
    circular="{{banners.length > 1}}"
    current="{{bannerCurrent}}"
    indicator-dots="{{false}}"
    bindchange="onBannerChange"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" data-index="{{index}}" bindtap="onBannerTap">
        <image class="banner-img" src="{{item.image}}" mode="aspectFill" lazy-load />
        <!-- 换成纯图片素材（overlay: true）时，自动叠加文案 -->
        <view wx:if="{{item.overlay}}" class="banner-caption">
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-subtitle">{{item.subtitle}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 左右切换控制：触屏点按，桌面/开发者工具也可用 -->
  <view
    wx:if="{{banners.length > 1}}"
    class="banner-arrow banner-arrow-prev"
    bindtap="bannerPrev"
    hover-class="banner-arrow-hover"
  >‹</view>
  <view
    wx:if="{{banners.length > 1}}"
    class="banner-arrow banner-arrow-next"
    bindtap="bannerNext"
    hover-class="banner-arrow-hover"
  >›</view>

  <!-- 指示器：当前项为胶囊，其余为小圆点（与整站圆角风格一致） -->
  <view wx:if="{{banners.length > 1}}" class="banner-dots">
    <view
      wx:for="{{banners}}"
      wx:key="id"
      class="banner-dot {{index === bannerCurrent ? 'banner-dot-on' : ''}}"
    ></view>
  </view>
</view>

<!-- 快捷入口：使用随包图标（此前是 emoji 文本，跨机型渲染不一致） -->
<view class="entry-grid">
  <view
    wx:for="{{entries}}"
    wx:key="label"
    class="entry-item"
    data-url="{{item.url}}"
    bindtap="goEntry"
  >
    <image class="entry-icon" src="{{item.iconSrc}}" mode="aspectFit" lazy-load />
    <view class="entry-label">{{item.label}}</view>
  </view>
</view>

<!-- 秒杀预告条：只展示未结束的活动（phase 由服务端计算） -->
<view wx:if="{{hasSeckill}}" class="seckill-strip">
  <view class="seckill-head" bindtap="goEntry" data-url="/pages/seckill/seckill">
    <text class="seckill-title">⚡ 限时秒杀</text>
    <text class="seckill-more">全部 ›</text>
  </view>
  <scroll-view scroll-x class="seckill-scroll">
    <view
      wx:for="{{seckillSkus}}"
      wx:key="skuId"
      class="seckill-item"
      data-url="/pages/seckill/seckill"
      bindtap="goEntry"
    >
      <image class="seckill-thumb" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
      <view class="seckill-name ellipsis">{{item.spuTitle}}</view>
      <view class="seckill-price">{{item.priceText}}</view>
      <view class="seckill-origin">¥{{item.originText}}</view>
      <view class="seckill-tag">{{item.phaseLabel}}</view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="onSearch">重试</button>
</view>

<!-- 骨架屏 -->
<view wx:elif="{{firstLoading}}" class="goods-grid">
  <view wx:for="{{skeletons}}" wx:key="*this" class="goods-card">
    <view class="skeleton sk-cover"></view>
    <view class="skeleton sk-line"></view>
    <view class="skeleton sk-line w40"></view>
  </view>
</view>

<view wx:elif="{{items.length === 0}}" class="empty">
  <view class="icon">🐾</view>
  <view>没有找到相关商品</view>
  <!-- 纠错建议：后端给不出靠谱候选时不会出现这一行 -->
  <view wx:if="{{suggestion}}" class="suggest-line">
    你是不是想搜
    <text class="suggest-word" bindtap="useSuggestion">「{{suggestion}}」</text>
    ？
  </view>
</view>

<view wx:else class="goods-grid">
  <view
    wx:for="{{items}}"
    wx:key="id"
    class="goods-card"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="goods-cover">
      <image src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
    </view>
    <view class="goods-body">
      <!-- 关键词命中片段高亮：分段渲染，不用 rich-text -->
      <view class="goods-name ellipsis-2">
        <text
          wx:for="{{item.titleSegs}}"
          wx:for-item="seg"
          wx:key="index"
          class="{{seg.hit ? 'hl' : ''}}"
        >{{seg.text}}</text>
      </view>
      <view class="goods-price-row">
        <view class="price goods-price">{{item.priceText}}</view>
        <text class="t3" style="font-size: 22rpx">已售 {{item.salesCount || 0}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{loading && items.length > 0}}" class="empty">加载更多…</view>
<view wx:elif="{{!hasMore && items.length > 0}}" class="empty">— 已经到底啦 —</view>

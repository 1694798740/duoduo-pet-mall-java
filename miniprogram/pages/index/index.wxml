<view class="search-bar">
  <input
    class="search-input"
    placeholder="搜索宠物用品"
    value="{{keyword}}"
    bindinput="onKeywordInput"
    bindconfirm="onSearch"
  />
  <button class="btn-primary search-btn" size="mini" bindtap="onSearch">搜索</button>
</view>

<view wx:if="{{error}}" class="empty">{{error}}</view>
<view wx:elif="{{loading && items.length === 0}}" class="empty">加载中…</view>
<view wx:elif="{{items.length === 0}}" class="empty">没有找到相关商品</view>

<view
  wx:for="{{items}}"
  wx:key="spuId"
  class="card product-item"
  data-id="{{item.spuId}}"
  bindtap="goDetail"
>
  <view class="product-title">{{item.title}}</view>
  <view class="product-meta">
    <text class="price">¥{{item.minPrice / 100}}</text>
    <text class="sales">已售 {{item.sales || 0}}</text>
  </view>
</view>

<view wx:if="{{loading && items.length > 0}}" class="empty">加载更多…</view>

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
}

.search-input {
  flex: 1;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-right: 16rpx;
}

.search-btn {
  width: 140rpx;
}

.product-title {
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sales {
  color: #999;
  font-size: 24rpx;
}

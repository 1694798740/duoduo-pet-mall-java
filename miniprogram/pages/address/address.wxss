/* 选择模式提示条（从结算页进入时显示） */
.pick-tip {
  margin: 20rpx 24rpx 0;
  padding: 16rpx 22rpx;
  border-radius: 12rpx;
  background: var(--brand-weak);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.6;
}
.addr-card-pick {
  border: 2rpx solid var(--brand);
}

/* 地址簿：列表卡 */
.addr-card {
  padding: 24rpx;
}
.addr-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}
.addr-phone {
  font-size: 26rpx;
  color: var(--text-2);
}
.addr-detail {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}
.addr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
.addr-act {
  font-size: 25rpx;
  color: var(--brand);
}
.addr-act-danger {
  color: #e5484d;
}

/* 表单 */
.sec-title {
  font-weight: 700;
  margin-bottom: 20rpx;
}
.field {
  margin-bottom: 22rpx;
}
.field-row {
  display: flex;
  gap: 20rpx;
}
.field-half {
  flex: 1;
  min-width: 0;
}
.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
/* input 必须显式给 height + line-height：
   box-sizing: border-box 下，小程序 input 的默认内容高度会被上下 padding 挤掉，
   文字只露出上半截 —— 这就是「格子太小、字显示不全」的原因。 */
.field-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: var(--text);
}
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  line-height: 1.5;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  color: var(--text);
}
.label-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.label-chip {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 25rpx;
}
.label-chip-on {
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 600;
}
.form-tip {
  margin: 0 24rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.footer-btn {
  flex: 1;
  height: 80rpx;
}
.footer-cancel {
  width: 200rpx;
  height: 80rpx;
  flex: none;
}

/* ---------- A1：省市区选择器 + 定位按钮（2026-10-20） ---------- */
.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.field-head .field-label {
  margin-bottom: 0;
}
.locate-btn {
  font-size: 24rpx;
  color: var(--brand);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-weak);
}
.locate-btn-busy {
  color: var(--text-3);
  background: var(--bg);
}
/* picker 内部的 view 不会继承 input 的排版，高度/行高要再写一遍 */
.picker-value {
  display: flex;
  align-items: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}
.picker-placeholder {
  color: var(--text-3);
}
.locate-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-3);
}

/* ---------- 地图选点按钮 + 附近候选（A1 增强，2026-10-20） ---------- */
.locate-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.locate-btn-plain {
  color: var(--text-2, var(--text-2));
  background: var(--bg);
}
.candidate-box {
  margin-top: 14rpx;
}
.candidate-title {
  display: block;
  font-size: 23rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}
.candidate-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.candidate-chip {
  font-size: 24rpx;
  line-height: 1.4;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.candidate-chip-on {
  background: var(--brand-weak);
  color: var(--brand);
}

<nav-bar title="收货地址" back="{{true}}" />

<!-- 地址簿：列表视图 -->
<block wx:if="{{mode === 'list'}}">
  <!-- 选择模式（从结算页进入）：明确告诉用户这一趟是来"选一个"的 -->
  <view wx:if="{{pickMode}}" class="pick-tip">请选择一个收货地址，本次结算将使用它</view>

  <view wx:if="{{error}}" class="error-box">
    <view>{{error}}</view>
    <button wx:if="{{needLogin}}" class="btn btn-plain btn-mini" bindtap="goLogin">去登录</button>
    <button wx:else class="btn btn-plain btn-mini" bindtap="fetchList">重试</button>
  </view>
  <view wx:elif="{{loading && list.length === 0}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="icon">📍</view>
    <view>还没有收货地址</view>
    <view class="t3" style="margin-top: 12rpx">添加后即可在小程序内下单</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card addr-card {{pickMode ? 'addr-card-pick' : ''}}"
    data-index="{{index}}"
    bindtap="pickAddress"
  >
    <view class="addr-main">
      <view class="addr-head">
        <text class="addr-name">{{item.receiverName}}</text>
        <text class="addr-phone">{{item.receiverPhone}}</text>
        <text wx:if="{{item.label}}" class="tag tag-brand">{{item.label}}</text>
        <text wx:if="{{item.isDefault}}" class="tag tag-accent">默认</text>
      </view>
      <view class="addr-detail">{{item.fullAddress || (item.province + item.city + item.district + item.detail)}}</view>
    </view>
    <view class="addr-actions">
      <view
        wx:if="{{!item.isDefault}}"
        class="addr-act"
        data-id="{{item.id}}"
        bindtap="setDefault"
      >设为默认</view>
      <view class="addr-act" data-index="{{index}}" bindtap="openEdit">编辑</view>
      <view class="addr-act addr-act-danger" data-id="{{item.id}}" bindtap="remove">删除</view>
    </view>
  </view>

  <view style="height: 160rpx"></view>
  <view class="footer">
    <button class="btn btn-accent footer-btn" bindtap="openCreate">+ 新增收货地址</button>
  </view>
</block>

<!-- 地址簿：新增 / 编辑表单 -->
<block wx:else>
  <view class="card">
    <view class="sec-title">{{editingId ? '编辑收货地址' : '新增收货地址'}}</view>

    <view class="field">
      <text class="field-label">收货人</text>
      <input
        class="field-input"
        maxlength="50"
        placeholder="请填写收货人姓名"
        value="{{form.receiverName}}"
        data-field="receiverName"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        value="{{form.receiverPhone}}"
        data-field="receiverPhone"
        bindinput="onInput"
      />
    </view>

    <!-- addr-region-field：定位失败时 pageScrollTo 的锚点，把用户带到"手动选择"这个兜底上 -->
    <view class="field addr-region-field">
      <view class="field-head">
        <text class="field-label">省 / 市 / 区</text>
        <view class="locate-actions">
          <view class="locate-btn {{locating ? 'locate-btn-busy' : ''}}" bindtap="locate">
            {{locating ? '定位中…' : '📍 定位当前地址'}}
          </view>
          <!-- 外卖式选点：打开微信原生地图，可拖动地标（无需高德 Key） -->
          <view class="locate-btn locate-btn-plain" bindtap="chooseOnMap">🗺️ 地图选点</view>
          <!-- 附近位置快选：微信原生 POI 列表，点一下即带入（wx.choosePoi，需单独申请） -->
          <view class="locate-btn locate-btn-plain" bindtap="chooseNearbyPoi">📋 附近位置</view>
        </view>
      </view>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="field-input picker-value {{form.province ? '' : 'picker-placeholder'}}">
          {{form.province ? form.province + ' / ' + form.city + ' / ' + form.district : '请选择省 / 市 / 区'}}
        </view>
      </picker>
      <text wx:if="{{locateHint}}" class="locate-hint">{{locateHint}}</text>
      <!-- 附近候选：单一回填可能落到隔壁路，让用户在附近挑一个 -->
      <view wx:if="{{candidates.length}}" class="candidate-box">
        <text class="candidate-title">附近位置（点一条填入详细地址）</text>
        <view class="candidate-list">
          <view
            wx:for="{{candidates}}"
            wx:key="name"
            class="candidate-chip {{form.detail === item.name ? 'candidate-chip-on' : ''}}"
            data-index="{{index}}"
            bindtap="pickCandidate"
          >
            {{item.name}}{{item.distance !== null ? ' · ' + item.distance + '米' : ''}}
          </view>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">详细地址</text>
      <textarea
        class="field-textarea"
        maxlength="200"
        placeholder="街道、门牌号等（最多 200 字）"
        value="{{form.detail}}"
        data-field="detail"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field-label">标签（选填）</text>
      <view class="label-row">
        <view
          wx:for="{{labels}}"
          wx:key="*this"
          class="label-chip {{form.label === item ? 'label-chip-on' : ''}}"
          data-label="{{item}}"
          bindtap="pickLabel"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view class="form-tip">提示：地址会用于下单时的收货信息快照，填写后可在列表设为「默认」，结算时优先使用。</view>

  <view style="height: 160rpx"></view>
  <view class="footer">
    <button class="btn btn-plain footer-cancel" bindtap="closeForm">取消</button>
    <button class="btn btn-accent footer-btn" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</block>

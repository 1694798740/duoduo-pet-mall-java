<!-- 地址簿：列表视图 -->
<block wx:if="{{mode === 'list'}}">
  <!-- 选择模式（从结算页进入）：明确告诉用户这一趟是来"选一个"的 -->
  <view wx:if="{{pickMode}}" class="pick-tip">请选择一个收货地址，本次结算将使用它</view>

  <view wx:if="{{error}}" class="error-box">
    <view>{{error}}</view>
    <button class="btn btn-plain btn-mini" bindtap="fetchList">重试</button>
  </view>
  <view wx:elif="{{loading && list.length === 0}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="icon">📍</view>
    <view>还没有收货地址</view>
    <view class="t3" style="margin-top: 12rpx">添加后即可在小程序内下单</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card addr-card {{pickMode ? 'addr-card-pick' : ''}}"
    data-index="{{index}}"
    bindtap="pickAddress"
  >
    <view class="addr-main">
      <view class="addr-head">
        <text class="addr-name">{{item.receiverName}}</text>
        <text class="addr-phone">{{item.receiverPhone}}</text>
        <text wx:if="{{item.label}}" class="tag tag-brand">{{item.label}}</text>
        <text wx:if="{{item.isDefault}}" class="tag tag-accent">默认</text>
      </view>
      <view class="addr-detail">{{item.fullAddress || (item.province + item.city + item.district + item.detail)}}</view>
    </view>
    <view class="addr-actions">
      <view
        wx:if="{{!item.isDefault}}"
        class="addr-act"
        data-id="{{item.id}}"
        bindtap="setDefault"
      >设为默认</view>
      <view class="addr-act" data-index="{{index}}" bindtap="openEdit">编辑</view>
      <view class="addr-act addr-act-danger" data-id="{{item.id}}" bindtap="remove">删除</view>
    </view>
  </view>

  <view style="height: 160rpx"></view>
  <view class="footer">
    <button class="btn btn-accent footer-btn" bindtap="openCreate">+ 新增收货地址</button>
  </view>
</block>

<!-- 地址簿：新增 / 编辑表单 -->
<block wx:else>
  <view class="card">
    <view class="sec-title">{{editingId ? '编辑收货地址' : '新增收货地址'}}</view>

    <view class="field">
      <text class="field-label">收货人</text>
      <input
        class="field-input"
        maxlength="50"
        placeholder="请填写收货人姓名"
        value="{{form.receiverName}}"
        data-field="receiverName"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        value="{{form.receiverPhone}}"
        data-field="receiverPhone"
        bindinput="onInput"
      />
    </view>

    <view class="field-row">
      <view class="field field-half">
        <text class="field-label">省份</text>
        <input class="field-input" maxlength="30" placeholder="如 广东省" value="{{form.province}}" data-field="province" bindinput="onInput" />
      </view>
      <view class="field field-half">
        <text class="field-label">城市</text>
        <input class="field-input" maxlength="30" placeholder="如 深圳市" value="{{form.city}}" data-field="city" bindinput="onInput" />
      </view>
    </view>

    <view class="field">
      <text class="field-label">区 / 县</text>
      <input class="field-input" maxlength="30" placeholder="如 南山区" value="{{form.district}}" data-field="district" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="field-label">详细地址</text>
      <textarea
        class="field-textarea"
        maxlength="200"
        placeholder="街道、门牌号等（最多 200 字）"
        value="{{form.detail}}"
        data-field="detail"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <text class="field-label">标签（选填）</text>
      <view class="label-row">
        <view
          wx:for="{{labels}}"
          wx:key="*this"
          class="label-chip {{form.label === item ? 'label-chip-on' : ''}}"
          data-label="{{item}}"
          bindtap="pickLabel"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view class="form-tip">提示：地址会用于下单时的收货信息快照，填写后可在列表设为「默认」，结算时优先使用。</view>

  <view style="height: 160rpx"></view>
  <view class="footer">
    <button class="btn btn-plain footer-cancel" bindtap="closeForm">取消</button>
    <button class="btn btn-accent footer-btn" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
  </view>
</block>

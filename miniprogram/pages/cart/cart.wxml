<view wx:if="{{error}}" class="error-box">{{error}}</view>
<view wx:elif="{{loading && items.length === 0}}" class="empty">加载中…</view>
<view wx:elif="{{items.length === 0}}" class="empty">
  <view class="icon">🛒</view>
  <view>购物车是空的，去逛逛吧</view>
</view>

<block wx:else>
  <!-- 收货地址：点击可临时切换（选择模式），下单用这里显示的地址 -->
  <view class="card addr-row" bindtap="chooseAddress">
    <text class="addr-icon">📍</text>
    <view class="addr-body">
      <block wx:if="{{address}}">
        <view class="addr-name">{{address.receiverName}} {{address.receiverPhone}}</view>
        <view class="t3 addr-full">{{address.fullAddress}}</view>
      </block>
      <view wx:else class="t3">请选择收货地址</view>
    </view>
    <text class="addr-arrow">›</text>
  </view>

  <view wx:for="{{items}}" wx:key="skuId" class="card cart-item {{item.valid ? '' : 'ci-invalid'}}">
    <!-- 勾选：下单只结已勾选条目，因此这里的勾选就是结算口径 -->
    <view class="ci-check" data-sku="{{item.skuId}}" bindtap="toggleSelect">
      <view class="checkbox {{item.selected && item.valid ? 'checkbox-on' : ''}}">
        {{item.selected && item.valid ? '✓' : ''}}
      </view>
    </view>

    <image class="ci-thumb" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />

    <view class="ci-main">
      <view class="ci-title ellipsis-2">{{item.title}}</view>
      <view class="t3 ci-spec">{{item.specText}}</view>
      <view wx:if="{{!item.valid}}" class="ci-reason">{{item.reasonText}}</view>
      <view class="ci-bottom">
        <view class="price">{{item.priceText}}</view>
        <view class="stepper">
          <view class="step-btn" data-sku="{{item.skuId}}" bindtap="dec">−</view>
          <view class="step-num">{{item.quantity}}</view>
          <view class="step-btn" data-sku="{{item.skuId}}" bindtap="inc">＋</view>
        </view>
      </view>
    </view>

    <view class="ci-del" data-sku="{{item.skuId}}" bindtap="removeItem">删除</view>
  </view>

  <view style="height: 140rpx"></view>
  <view class="footer">
    <view class="footer-total">
      合计 <text class="price">{{selectedAmountText}}</text>
      <text class="t3">（已选 {{selectedCount}} 件）</text>
    </view>
    <button
      class="btn btn-accent footer-btn"
      bindtap="placeOrder"
      disabled="{{ordering || selectedCount === 0}}"
      loading="{{ordering}}"
    >
      去结算
    </button>
  </view>
</block>

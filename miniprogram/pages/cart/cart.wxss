.cart-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.ci-main { flex: 1; }
.ci-title { font-size: 28rpx; font-weight: 500; }
.ci-spec { font-size: 22rpx; margin: 8rpx 0; }
.ci-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
}
.step-btn {
  width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-2);
}
.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-left: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
  padding: 0 8rpx;
}
.ci-del {
  align-self: center;
  color: #e5484d;
  background: #fff1f0;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.footer-total { flex: 1; text-align: right; }
.footer-btn { width: 260rpx; height: 76rpx; }

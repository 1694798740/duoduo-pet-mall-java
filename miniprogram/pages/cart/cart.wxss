.cart-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

/* 勾选：结算只结已勾选条目，勾选框就是结算口径的可视化 */
.ci-check {
  display: flex;
  align-items: center;
  padding-right: 4rpx;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.checkbox-on {
  background: var(--accent);
  border-color: var(--accent);
}

/* 商品缩略图：与列表/详情同一套图，保证「同商品同图」 */
.ci-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  flex: none;
  align-self: center;
  background: var(--bg);
}
.ci-main { flex: 1; }
.ci-title { font-size: 28rpx; font-weight: 500; }
.ci-spec { font-size: 22rpx; margin: 8rpx 0; }
/* 失效条目：整行置灰 + 标出原因，不再混进合计 */
.ci-invalid .ci-title,
.ci-invalid .ci-spec,
.ci-invalid .price { color: var(--text-3); }
.ci-reason {
  display: inline-block;
  font-size: 20rpx;
  color: #e5484d;
  background: #fff1f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-bottom: 6rpx;
}
.ci-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
}
.step-btn {
  width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-2);
}
.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border-left: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
  padding: 0 8rpx;
}
.ci-del {
  align-self: center;
  color: #e5484d;
  background: #fff1f0;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.footer-total { flex: 1; text-align: right; }
.footer-btn { width: 260rpx; height: 76rpx; }

<nav-bar title="限时秒杀" back="{{true}}" />

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="fetch">重试</button>
</view>
<view wx:elif="{{loading}}" class="empty">加载中…</view>
<view wx:elif="{{activities.length === 0}}" class="empty">
  <view class="icon">⚡</view>
  <view>暂无秒杀活动，敬请期待</view>
</view>

<block wx:else>
  <view wx:for="{{activities}}" wx:for-item="act" wx:key="id" class="card act-card">
    <view class="act-head">
      <view class="act-title">{{act.title}}</view>
      <view class="tag {{act.phase === 'ONGOING' ? 'tag-accent' : 'tag-gray'}}">{{act.phaseLabel}}</view>
    </view>
    <view class="t3 act-time">{{act.startText}} ~ {{act.endText}}</view>

    <view wx:for="{{act.skus}}" wx:for-item="sku" wx:key="skuId" class="sk-sku">
      <image class="sk-thumb" src="{{sku.imageSrc}}" mode="aspectFill" lazy-load />
      <view class="sk-info">
        <view class="ellipsis sk-name">{{sku.spuTitle}}</view>
        <view class="sk-price-row">
          <view class="sk-price">{{sku.seckillPriceText}}</view>
          <text class="price-origin">¥{{sku.originalPriceText}}</text>
          <text class="t3">剩余 {{sku.availableStock}}/{{sku.totalStock}}</text>
        </view>
        <view class="t3" style="font-size: 20rpx">每人限购 {{sku.perLimit}} 件</view>
      </view>
      <button
        class="btn btn-accent sk-btn"
        size="mini"
        data-activity-id="{{act.id}}"
        data-sku-id="{{sku.skuId}}"
        data-phase="{{act.phase}}"
        bindtap="buy"
        disabled="{{act.phase !== 'ONGOING' || sku.soldOut || placingSkuId === sku.skuId}}"
        loading="{{placingSkuId === sku.skuId}}"
      >
        {{sku.soldOut ? '已抢光' : (act.phase === 'ONGOING' ? '马上抢' : act.phaseLabel)}}
      </button>
    </view>
  </view>
</block>

/* ── 我的闲置（第五十二轮） ── */
.fmine { padding-bottom: 40rpx; }

.fmine-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx 12rpx;
}
/* 筛选条（第五十三轮热修二）：标签「不换行 + 高度一致 + 按内容自适应」。
   原来 6 个标签挤在一行被 flex 压窄，「审核中/审核失败/已下架/已售出」都被折成两行
   —— 看上去忽大忽小。现在标签 flex: none 保持单行，整条可横向滚动（挤不下就滑，不压缩）。 */
.fmine-filters {
  display: flex;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}
.fmine-filter {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  background: var(--card);
  color: var(--text-2);
  border-radius: 28rpx;
  font-size: 25rpx;
  white-space: nowrap;
}
.fmine-filter-on {
  background: var(--brand-weak);
  color: var(--brand);
  font-weight: 600;
}
.fmine-add {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 26rpx;
  background: var(--accent);
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.fmine-list { padding: 0 24rpx; }
.fmine-item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx;
  margin-top: 18rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: 0 2rpx 12rpx rgba(35, 38, 47, 0.04);
}
.fmine-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 14rpx;
  background: var(--bg);
  flex: none;
}
.fmine-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.fmine-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 徽章（第五十三轮热修二）：只展示**一个**状态 —— 与筛选标签同源，
   不再同时挂「审核中」+「在售」两个标签（同一件闲置只属于一个状态）。 */
.fmine-badges { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.fmine-badge {
  flex: none;
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}
/* 配色与语义对齐：待审=提示 / 驳回=警示 / 在售=正常 / 下架·已售=中性 */
.fm-badge-pending { background: #fff7e6; color: #b7791f; }
.fm-badge-rejected { background: var(--accent-weak, rgba(240, 82, 82, 0.12)); color: var(--accent); }
.fm-badge-onsale { background: #e8f8ee; color: #1aad19; }
.fm-badge-off { background: var(--bg); color: var(--text-2); }
.fm-badge-sold { background: var(--brand-weak); color: var(--brand); }

.fmine-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}
.fmine-price { color: var(--accent); font-size: 32rpx; font-weight: 700; }
/* 浏览与想要并列（第五十四轮）：卖家看到的「想要」= 有多少买家为它咨询过 */
.fmine-stat { font-size: 22rpx; color: var(--text-3); }

.fmine-reason {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background: var(--accent-weak);
  color: var(--accent);
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 卡片内操作行（第五十三轮热修二）：按钮文字单行、高度一致；放不下时换行而不压缩 */
.fmine-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}
.fmine-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  background: var(--bg);
  color: var(--text-2);
  white-space: nowrap;
}
.fmine-btn-on { background: var(--brand-weak); color: var(--brand); font-weight: 600; }
/* 修改并重提（第五十三轮）：驳回条目的主操作，用警示色与普通按钮区分 */
.fmine-btn-resubmit { background: var(--accent-weak, rgba(240, 82, 82, 0.12)); color: var(--accent); font-weight: 600; }
.fmine-time { flex: none; margin-left: auto; font-size: 22rpx; color: var(--text-3); white-space: nowrap; }

.fmine-state {
  padding: 60rpx 24rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}
.fmine-error { color: var(--accent); }

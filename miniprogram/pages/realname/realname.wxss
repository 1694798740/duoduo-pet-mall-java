/* 实名认证页样式（对齐 flea-publish 的卡片风格） */
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.box {
  background: var(--card);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}

.box-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.box-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.ok-badge {
  display: inline-block;
  background: #e8f7ee;
  color: #1f9d55;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin-bottom: 28rpx;
}

.field-line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.fl-label {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.fl-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

.error {
  background: #fdecec;
  color: #d93025;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}

.btn {
  width: 100%;
  border-radius: 999rpx;
  font-size: 30rpx;
  margin-top: 8rpx;
}

.btn.primary {
  background: #4f6ef7;
  color: #ffffff;
}

.tip {
  font-size: 24rpx;
  color: #9aa1ad;
  line-height: 1.6;
  margin-top: 24rpx;
}

<nav-bar title="客服" back="{{true}}" />

<view wx:if="{{error}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="retry">重试</button>
</view>
<view wx:elif="{{loading}}" class="empty">正在接通客服…</view>

<block wx:else>
  <view class="chat-page" style="height: calc(100vh - {{navTotal}}px)">
    <!-- 会话头部：接待方（自营客服 / 某商家客服）
         ★ 2026-10-23：不再显示任何会话状态 —— 关闭只是客服侧的收尾标记。 -->
    <view class="chat-head">
      <image class="chat-avatar" src="{{sellerAvatar || '/images/category/default.png'}}" mode="aspectFill" />
      <view class="chat-head-info">
        <view class="chat-nick">{{sellerName}}</view>
        <view class="t3">客服消息 · 不受互相关注限制</view>
      </view>
      <view wx:if="{{items.length && !ended}}" class="chat-end" bindtap="endConsult">结束咨询</view>
    </view>

    <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view wx:if="{{items.length === 0}}" class="empty">有问题直接问，客服会尽快回复</view>
      <block
        wx:for="{{items}}"
        wx:key="id"
      >
        <!-- 会话中央时间分隔条（2026-10-25）：10 分钟内的连续消息不重复显示时间 -->
        <view wx:if="{{item.timeSep}}" class="chat-time-sep">{{item.timeSep}}</view>
        <view
          id="msg-{{item.id}}"
          class="msg-row {{!selectMode && item.mine ? 'msg-mine' : ''}} {{selectMode ? 'msg-selecting' : ''}}"
          data-msg="{{item}}"
          bindlongpress="onMsgLongPress"
        >
          <!-- 多选删除模式（2026-10-25） -->
          <view wx:if="{{selectMode}}" class="msg-check-wrap" catchtap="toggleSelect" data-id="{{item.id}}">
            <view class="msg-check {{item.checked ? 'on' : ''}}">✓</view>
          </view>
          <block wx:if="{{!selectMode && !item.recalled}}">
            <image
              wx:if="{{!item.mine}}"
              class="msg-avatar"
              src="{{sellerAvatar || '/images/category/default.png'}}"
              mode="aspectFill"
            />
          </block>
          <view class="msg-col">
            <!-- 撤回后整行居中灰字（2026-10-25） -->
            <view wx:if="{{item.recalled}}" class="chat-recalled">{{item.mine ? '你撤回了一条消息' : '对方撤回了一条消息'}}</view>
            <block wx:else>
            <view
              wx:if="{{item.card}}"
              class="msg-card"
              data-spu="{{item.card.productId}}"
              catchtap="goProduct"
            >
              <image class="msg-card-img" src="{{item.cardImage}}" mode="aspectFill" />
              <view class="msg-card-info">
                <view class="msg-card-title ellipsis-2">{{item.card.title}}</view>
                <view wx:if="{{item.cardPriceText}}" class="price msg-card-price">{{item.cardPriceText}}</view>
              </view>
            </view>
            <image
              wx:if="{{item.bizType === 'IMAGE'}}"
              class="msg-media"
              src="{{item.mediaUrl}}"
              mode="widthFix"
              data-url="{{item.mediaUrl}}"
              bindtap="previewImage"
            />
            <video
              wx:elif="{{item.bizType === 'VIDEO'}}"
              class="msg-media"
              src="{{item.mediaUrl}}"
              poster="{{item.thumbUrl}}"
              object-fit="contain"
            />
            <view
              wx:elif="{{item.bizType === 'VOICE'}}"
              class="msg-voice"
              data-url="{{item.mediaUrl}}"
              bindtap="playVoice"
            >
              <text class="msg-voice-icon">▶</text>
              <view class="msg-voice-bar"></view>
              <text class="msg-voice-dur">{{item.voiceSecs}}"</text>
            </view>
            <view wx:else class="msg-bubble {{item.mine ? 'msg-bubble-mine' : ''}}">
              <view wx:if="{{item.quotedExcerpt}}" class="msg-quoted" catchtap="jumpQuoted" data-id="{{item.quotedId}}">{{item.quotedExcerpt}}</view>
              <text>{{item.content}}</text>
            </view>
            </block>
            <view wx:if="{{!selectMode}}" class="t3 msg-time"><text wx:if="{{item.mine && !item.read && !item.recalled}}" class="msg-unread">未读</text></view>
          </view>
        </view>
      </block>
      <!-- 结束后的系统小字：只在本会话内可见，不弹 toast、不出现"关闭"字样 -->
      <view wx:if="{{ended}}" class="chat-system">当前会话已结束</view>
      <view style="height: 20rpx"></view>
    </scroll-view>

    <!-- 多选删除工具条（2026-10-25） -->
    <view wx:if="{{selectMode}}" class="chat-select-bar">
      <button class="btn btn-plain btn-mini" bindtap="toggleAllSelect">
        {{selectedIds.length === items.length && items.length ? '取消全选' : '全选'}}
      </button>
      <text class="t3">已选 {{selectedIds.length}} 条</text>
      <view style="flex:1"></view>
      <button class="btn btn-plain btn-mini" bindtap="cancelSelect">取消</button>
      <button
        class="btn btn-accent btn-mini"
        disabled="{{!selectedIds.length}}"
        bindtap="deleteSelected"
      >删除</button>
    </view>

    <view wx:if="{{typingVisible}}" class="chat-typing">对方正在输入…</view>
    <!-- 引用条（2026-10-24）：点击取消 -->
    <view wx:if="{{replyTo}}" class="msg-quoted chat-quote-bar" bindtap="cancelQuote">{{replyText}}　✕</view>
    <!-- 点击式录音控制条（2026-10-25） -->
    <view wx:if="{{recState}}" class="chat-recording chat-rec-bar">
      <text>{{recState === 'paused' ? '已暂停' : '录音中'}} {{recSecs}}s（最长 60 秒）</text>
      <button class="btn btn-plain btn-mini" bindtap="voiceCancel">取消</button>
      <button wx:if="{{recState === 'paused'}}" class="btn btn-plain btn-mini" bindtap="voiceResume">继续</button>
      <button wx:else class="btn btn-plain btn-mini" bindtap="voicePause">暂停</button>
      <button class="btn btn-accent btn-mini" bindtap="voiceStop">结束并发送</button>
    </view>

    <view class="chat-input-bar">
      <view class="chat-plus emoji-btn" bindtap="toggleEmoji">😀</view>
      <view class="chat-plus" bindtap="pickMedia">＋</view>
      <!-- 麦克风图标（2026-10-25）：点击开始，再次点击结束并发送 -->
      <view
        class="chat-plus chat-mic-btn {{recState ? 'recording' : ''}}"
        bindtap="voiceTap"
      >🎤</view>
      <input
        class="chat-input"
        value="{{input}}"
        placeholder="描述你的问题…"
        placeholder-class="chat-ph"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="send"
      />
      <button
        class="btn btn-accent chat-send"
        size="mini"
        bindtap="send"
        disabled="{{sending || !input}}"
        loading="{{sending}}"
      >
        发送
      </button>
    </view>

    <!-- 表情 / 贴纸面板：与 Web 同一清单（56 + 12），点表情拼进输入框 -->
    <view wx:if="{{emojiOpen}}" class="emoji-panel">
      <view class="emoji-tabs">
        <view class="emoji-tab {{emojiTab === 'emoji' ? 'on' : ''}}" data-tab="emoji" bindtap="switchEmojiTab">表情</view>
        <view wx:if="{{stickers.length}}" class="emoji-tab {{emojiTab === 'sticker' ? 'on' : ''}}" data-tab="sticker" bindtap="switchEmojiTab">贴纸</view>
      </view>
      <scroll-view scroll-y class="emoji-scroll">
        <view wx:if="{{emojiTab === 'emoji'}}" class="emoji-grid">
          <view wx:for="{{emojis}}" wx:key="*this" class="emoji-cell" data-e="{{item}}" bindtap="pickEmoji">{{item}}</view>
        </view>
        <view wx:else class="emoji-grid sticker-grid">
          <image
            wx:for="{{stickers}}"
            wx:key="*this"
            class="sticker-cell"
            src="{{item}}"
            mode="aspectFit"
            data-url="{{item}}"
            bindtap="pickSticker"
          />
        </view>
      </scroll-view>
    </view>
  </view>
</block>

/* 客服页复用私信页的气泡语言（同一套 .chat-* / .msg-* 样式）。
 *
 * 为什么用 @import 而不是复制一份：两页视觉必须一致，复制出来的第二份
 * 在改配色时必然漂移；抽公共文件则要动 chat 页，风险大于收益。
 * 规则层的差异由 js 决定（客服没有互关/限发），与样式无关。 */
@import "../chat/chat.wxss";

/* B 批：媒体气泡与「+」按钮 */
.chat-plus {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f2f6;
  color: #5b6070;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 12rpx;
}
.msg-media {
  width: 360rpx;
  max-height: 420rpx;
  border-radius: 16rpx;
  background: #f1f2f6;
}

/* 结束咨询：弱化入口，不和头像抢视觉；语义上只是「我这边问完了」 */
.chat-end {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e3e5ec;
  color: #7a8091;
  font-size: 22rpx;
  line-height: 1.4;
}
.chat-end:active {
  background: #f1f2f6;
}

/* 结束后的系统小字：居中、弱化，与 Web 端 .sup-system 同口径 */
.chat-system {
  text-align: center;
  font-size: 22rpx;
  color: #9aa0b0;
  padding: 16rpx 0 8rpx;
}

/* 语音 / 引用 / 撤回（2026-10-24） */
.msg-voice {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 200rpx;
  padding: 14rpx 22rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
}
.msg-mine .msg-voice { background: #ffe8cf; }
.msg-voice-icon { font-size: 26rpx; }
.msg-voice-bar {
  width: 120rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(0, 0, 0, 0.15);
}
.msg-voice-dur { font-size: 22rpx; color: #8a919f; }
.msg-quoted {
  font-size: 22rpx;
  color: #8a919f;
  background: rgba(0, 0, 0, 0.05);
  border-left: 4rpx solid rgba(0, 0, 0, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chat-quote-bar { padding: 10rpx 16rpx; margin: 0 24rpx 8rpx; }
.chat-recalled { font-size: 22rpx; color: #8a919f; padding: 4rpx 0; }
.chat-recording { font-size: 22rpx; color: #d03050; padding: 4rpx 24rpx 8rpx; }
.chat-voice-btn.recording { background: #d03050; color: #fff; border-radius: 50%; }

/* ===== 2026-10-25 追加：时间分隔条 / 点击录音 / 多选删除 ===== */
.chat-time-sep {
  text-align: center;
  font-size: 22rpx;
  color: #8a919f;
  margin: 20rpx 0 8rpx;
}
.chat-recalled { text-align: center; width: 100%; }
.chat-rec-bar { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.chat-mic-btn { font-size: 36rpx; }
.msg-check-wrap { display: flex; align-items: center; padding: 0 8rpx; }
.msg-check {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #c3c8d0; color: transparent;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.msg-check.on { background: #3b82f6; border-color: #3b82f6; color: #fff; }
.msg-selecting .msg-col { max-width: 70%; }
.chat-select-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 12rpx 24rpx; border-top: 1rpx solid #e5e8ef; background: #fff;
}

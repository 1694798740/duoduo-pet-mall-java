/* 客服页复用私信页的气泡语言（同一套 .chat-* / .msg-* 样式）。
 *
 * 为什么用 @import 而不是复制一份：两页视觉必须一致，复制出来的第二份
 * 在改配色时必然漂移；抽公共文件则要动 chat 页，风险大于收益。
 * 规则层的差异由 js 决定（客服没有互关/限发），与样式无关。 */
@import "../chat/chat.wxss";

/* B 批：媒体气泡与「+」按钮 */
.chat-plus {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f2f6;
  color: #5b6070;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 12rpx;
}
.msg-media {
  width: 360rpx;
  max-height: 420rpx;
  border-radius: 16rpx;
  background: #f1f2f6;
}

/* 结束咨询：弱化入口，不和头像抢视觉；语义上只是「我这边问完了」 */
.chat-end {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e3e5ec;
  color: #7a8091;
  font-size: 22rpx;
  line-height: 1.4;
}
.chat-end:active {
  background: #f1f2f6;
}

/* 结束后的系统小字：居中、弱化，与 Web 端 .sup-system 同口径 */
.chat-system {
  text-align: center;
  font-size: 22rpx;
  color: #9aa0b0;
  padding: 16rpx 0 8rpx;
}

<nav-bar title="AI 助手" back="{{true}}" />

<scroll-view scroll-y class="chat-list" style="height: calc(100vh - 120rpx - {{navTotal}}px)" scroll-into-view="{{scrollInto}}" scroll-with-animation>
  <view wx:for="{{messages}}" wx:key="id" wx:for-item="msg" id="msg-{{msg.id}}">
    <view class="bubble-row {{msg.role === 'user' ? 'row-user' : ''}}">
      <view wx:if="{{msg.role === 'assistant'}}" class="chat-avatar">🐱</view>
      <view class="bubble {{msg.role === 'user' ? 'bubble-user' : ''}} {{msg.error ? 'bubble-error' : ''}}">
        {{msg.content}}
      </view>
    </view>
    <!-- 推荐商品卡片 -->
    <view wx:if="{{msg.recs && msg.recs.length > 0}}" class="rec-list">
      <view
        wx:for="{{msg.recs}}"
        wx:for-item="rec"
        wx:key="id"
        class="rec-card"
        data-id="{{rec.id}}"
        bindtap="goDetail"
      >
        <view class="rec-title ellipsis">{{rec.title}}</view>
        <view class="t3 rec-sub ellipsis">{{rec.subtitle}}</view>
        <view class="rec-bottom">
          <text class="price">¥{{rec.priceText}}</text>
          <text class="tag {{rec.inStock ? 'tag-brand' : 'tag-gray'}}">
            {{rec.inStock ? '有货' : '缺货'}}
          </text>
        </view>
      </view>
    </view>

    <!-- 澄清选项（第五十七轮）：点一下就发出去，用户不必打字。
         开放式追问（「请补充更多信息」）用户往往直接忽略，把澄清成本降到一次点击它才会被用。 -->
    <view wx:if="{{msg.options && msg.options.length > 0}}" class="clarify-list">
      <view
        wx:for="{{msg.options}}"
        wx:for-item="opt"
        wx:key="label"
        class="clarify-chip"
        data-send="{{opt.send}}"
        bindtap="tapOption"
      >{{opt.label}}</view>
    </view>

    <!-- 相关追问（第五十八轮 S3）：由本轮候选推导，不是固定文案。
         样式与澄清选项同形（胶囊），颜色更淡 —— 澄清是「AI 在问你」，追问是「你还可以问」。 -->
    <view wx:if="{{msg.followUps && msg.followUps.length > 0}}" class="clarify-list">
      <view
        wx:for="{{msg.followUps}}"
        wx:key="*this"
        class="clarify-chip chip-muted"
        data-send="{{item}}"
        bindtap="tapOption"
      >{{item}}</view>
    </view>
  </view>

  <!-- 快捷问题（第五十八轮 S3）：只在「还没聊起来」时出现（首屏只有问候语）。
       聊过之后再显示这些类目级问题会打断话题，而用户此刻问的通常更具体。 -->
  <view wx:if="{{messages.length <= 1 && quickQuestions.length > 0}}" class="ai-quick">
    <view class="ai-quick-title">大家都在问</view>
    <view class="ai-quick-list">
      <view
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        class="clarify-chip"
        data-send="{{item}}"
        bindtap="tapOption"
      >{{item}}</view>
    </view>
  </view>
  <view wx:if="{{sending}}" class="bubble-row">
    <view class="chat-avatar">🐱</view>
    <view class="bubble">多多思考中…</view>
  </view>
  <view style="height: 24rpx"></view>
</scroll-view>

<!-- 输入条：键盘弹出时上移（keyboardHeight 由 wx.onKeyboardHeightChange 提供） -->
<view class="chat-input-bar" style="bottom: {{keyboardHeight}}px">
  <input
    class="chat-input"
    placeholder="{{aiReady ? '想买什么？告诉多多（最多 500 字）' : 'AI 导购暂不可用'}}"
    value="{{input}}"
    maxlength="500"
    confirm-type="send"
    adjust-position="{{false}}"
    cursor-spacing="24"
    bindinput="onInput"
    bindconfirm="send"
    disabled="{{!aiReady}}"
  />
  <button class="btn btn-primary chat-send" size="mini" bindtap="send" disabled="{{sending || !aiReady}}">
    发送
  </button>
</view>

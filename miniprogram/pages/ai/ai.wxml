<nav-bar title="AI 助手" back="{{true}}" />

<scroll-view scroll-y class="chat-list" style="height: calc(100vh - 120rpx - {{navTotal}}px)" scroll-into-view="{{scrollInto}}" scroll-with-animation>
  <view wx:for="{{messages}}" wx:key="id" wx:for-item="msg" id="msg-{{msg.id}}">
    <view class="bubble-row {{msg.role === 'user' ? 'row-user' : ''}}">
      <view wx:if="{{msg.role === 'assistant'}}" class="chat-avatar">🐱</view>
      <view class="bubble {{msg.role === 'user' ? 'bubble-user' : ''}} {{msg.error ? 'bubble-error' : ''}}">
        {{msg.content}}
      </view>
    </view>
    <!-- 推荐商品卡片 -->
    <view wx:if="{{msg.recs && msg.recs.length > 0}}" class="rec-list">
      <view
        wx:for="{{msg.recs}}"
        wx:for-item="rec"
        wx:key="id"
        class="rec-card"
        data-id="{{rec.id}}"
        bindtap="goDetail"
      >
        <view class="rec-title ellipsis">{{rec.title}}</view>
        <view class="t3 rec-sub ellipsis">{{rec.subtitle}}</view>
        <view class="rec-bottom">
          <text class="price">¥{{rec.priceText}}</text>
          <text class="tag {{rec.inStock ? 'tag-brand' : 'tag-gray'}}">
            {{rec.inStock ? '有货' : '缺货'}}
          </text>
        </view>
      </view>
    </view>

    <!-- 服务端装配的结构化卡片（阶段四）：通知 / 券 / 订单 / 宫格。
         点击统一走 utils/navigate（TabBar 用 switchTab、栈满自动降级），
         跳转地址一律来自服务端 miniPath，页面不拼路径。 -->
    <view wx:if="{{msg.cards && msg.cards.length > 0}}" class="ai-card-list">
      <view wx:for="{{msg.cards}}" wx:for-item="card" wx:key="_key">
        <!-- 通知列表 -->
        <view wx:if="{{card.type === 'notification_list'}}" class="ai-card">
          <view class="ai-card-head">
            <text class="ai-card-title">{{card.title}}</text>
            <text wx:if="{{card.unreadCount > 0}}" class="ai-card-badge">{{card.unreadCount}}</text>
          </view>
          <view wx:if="{{card.items.length === 0}}" class="t3">暂无符合条件的通知</view>
          <view
            wx:for="{{card.items}}"
            wx:for-item="it"
            wx:key="_key"
            class="ai-notice {{it.read ? '' : 'ai-notice-unread'}}"
            data-path="{{it.miniPath}}"
            bindtap="tapCard"
          >
            <view class="ai-notice-dot"></view>
            <view class="ai-notice-body">
              <view class="ai-notice-title">{{it.title}}</view>
              <view wx:if="{{it.summary}}" class="t3 ellipsis">{{it.summary}}</view>
              <view class="t3">{{it.meta}}</view>
            </view>
          </view>
          <view wx:if="{{card.actions.length > 0}}" class="ai-card-actions">
            <view
              wx:for="{{card.actions}}"
              wx:for-item="act"
              wx:key="_key"
              class="clarify-chip"
              data-path="{{act.miniPath}}"
              bindtap="tapCard"
            >{{act.label}}</view>
          </view>
        </view>

        <!-- 券包 -->
        <view wx:if="{{card.type === 'coupon_list'}}" class="ai-card">
          <view class="ai-card-head">
            <text class="ai-card-title">{{card.title}}</text>
          </view>
          <view wx:if="{{card.items.length === 0}}" class="t3">券包里还没有符合条件的券</view>
          <view
            wx:for="{{card.items}}"
            wx:for-item="it"
            wx:key="_key"
            class="ai-coupon"
            data-path="{{it.miniPath}}"
            bindtap="tapCard"
          >
            <view class="ai-coupon-left">
              <view class="ai-coupon-amount">{{it.amountText}}</view>
              <view class="t3">{{it.thresholdText}}</view>
            </view>
            <view class="ai-coupon-right">
              <view class="ai-coupon-name ellipsis">{{it.name}}</view>
              <view class="t3 ellipsis">{{it.meta}}</view>
            </view>
            <text wx:if="{{it.statusLabel}}" class="tag">{{it.statusLabel}}</text>
          </view>
          <view wx:if="{{card.actions.length > 0}}" class="ai-card-actions">
            <view
              wx:for="{{card.actions}}"
              wx:for-item="act"
              wx:key="_key"
              class="clarify-chip"
              data-path="{{act.miniPath}}"
              bindtap="tapCard"
            >{{act.label}}</view>
          </view>
        </view>

        <!-- 订单 -->
        <view wx:if="{{card.type === 'order_list'}}" class="ai-card">
          <view class="ai-card-head">
            <text class="ai-card-title">{{card.title}}</text>
          </view>
          <view wx:if="{{card.items.length === 0}}" class="t3">没有符合条件的订单</view>
          <view
            wx:for="{{card.items}}"
            wx:for-item="it"
            wx:key="_key"
            class="ai-order"
            data-path="{{it.miniPath}}"
            bindtap="tapCard"
          >
            <view class="ai-order-top">
              <text class="t3">订单 …{{it.tail}}</text>
              <text class="tag">{{it.statusText}}</text>
            </view>
            <view class="ai-order-summary ellipsis">{{it.summary}}</view>
            <view class="ai-order-bottom">
              <text class="t3">{{it.timeText}}</text>
              <text class="ai-order-amount">{{it.amountText}}</text>
            </view>
          </view>
          <view wx:if="{{card.actions.length > 0}}" class="ai-card-actions">
            <view
              wx:for="{{card.actions}}"
              wx:for-item="act"
              wx:key="_key"
              class="clarify-chip"
              data-path="{{act.miniPath}}"
              bindtap="tapCard"
            >{{act.label}}</view>
          </view>
        </view>

        <!-- 导航宫格 -->
        <view wx:if="{{card.type === 'action_grid'}}" class="ai-card">
          <view class="ai-card-head">
            <text class="ai-card-title">{{card.title}}</text>
          </view>
          <view class="ai-grid">
            <view
              wx:for="{{card.items}}"
              wx:for-item="it"
              wx:key="_key"
              class="clarify-chip"
              data-path="{{it.miniPath}}"
              bindtap="tapCard"
            >{{it.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 登录入口（游客轮次用尽 / 功能需登录）：小程序跳自己的登录页 -->
    <view wx:if="{{msg.needLogin}}" class="ai-login">
      <text class="t3">登录后可以查订单、通知和优惠券</text>
      <view class="clarify-chip" bindtap="goLogin">去登录</view>
    </view>

    <!-- 澄清选项（第五十七轮）：点一下就发出去，用户不必打字。
         开放式追问（「请补充更多信息」）用户往往直接忽略，把澄清成本降到一次点击它才会被用。 -->
    <view wx:if="{{msg.options && msg.options.length > 0}}" class="clarify-list">
      <view
        wx:for="{{msg.options}}"
        wx:for-item="opt"
        wx:key="label"
        class="clarify-chip"
        data-send="{{opt.send}}"
        bindtap="tapOption"
      >{{opt.label}}</view>
    </view>

    <!-- 相关追问（第五十八轮 S3）：由本轮候选推导，不是固定文案。
         样式与澄清选项同形（胶囊），颜色更淡 —— 澄清是「AI 在问你」，追问是「你还可以问」。 -->
    <view wx:if="{{msg.followUps && msg.followUps.length > 0}}" class="clarify-list">
      <view
        wx:for="{{msg.followUps}}"
        wx:key="*this"
        class="clarify-chip chip-muted"
        data-send="{{item}}"
        bindtap="tapOption"
      >{{item}}</view>
    </view>
  </view>

  <!-- 快捷问题（第五十八轮 S3）：只在「还没聊起来」时出现（首屏只有问候语）。
       聊过之后再显示这些类目级问题会打断话题，而用户此刻问的通常更具体。 -->
  <view wx:if="{{messages.length <= 1 && quickQuestions.length > 0}}" class="ai-quick">
    <view class="ai-quick-title">大家都在问</view>
    <view class="ai-quick-list">
      <view
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        class="clarify-chip"
        data-send="{{item}}"
        bindtap="tapOption"
      >{{item}}</view>
    </view>
  </view>
  <view wx:if="{{sending}}" class="bubble-row">
    <view class="chat-avatar">🐱</view>
    <view class="bubble">多多思考中…</view>
  </view>
  <view style="height: 24rpx"></view>
</scroll-view>

<!-- 输入条：键盘弹出时上移（keyboardHeight 由 wx.onKeyboardHeightChange 提供） -->
<view class="chat-input-bar" style="bottom: {{keyboardHeight}}px">
  <input
    class="chat-input"
    placeholder="{{aiReady ? '想买什么？告诉多多（最多 500 字）' : 'AI 导购暂不可用'}}"
    value="{{input}}"
    maxlength="500"
    confirm-type="send"
    adjust-position="{{false}}"
    cursor-spacing="24"
    bindinput="onInput"
    bindconfirm="send"
    disabled="{{!aiReady}}"
  />
  <button class="btn btn-primary chat-send" size="mini" bindtap="send" disabled="{{sending || !aiReady}}">
    发送
  </button>
</view>

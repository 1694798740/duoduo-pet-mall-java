.chat-list {
  height: calc(100vh - 120rpx);
  padding: 24rpx;
  box-sizing: border-box;
}
.bubble-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; align-items: flex-start; }
.row-user { flex-direction: row-reverse; }
.chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.bubble {
  max-width: 70%;
  background: #fff;
  border-radius: 4rpx 24rpx 24rpx 24rpx;
  padding: 20rpx 24rpx;
  font-size: 27rpx;
  line-height: 1.6;
  box-shadow: 0 2rpx 8rpx rgba(35, 38, 47, 0.04);
  word-break: break-all;
}
.bubble-user { background: var(--brand); color: #fff; border-radius: 24rpx 4rpx 24rpx 24rpx; }
.bubble-error { color: #e5484d; background: #fff1f0; }
.rec-list { margin: -8rpx 0 24rpx 80rpx; }
.rec-card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.rec-title { font-size: 27rpx; font-weight: 600; }
.rec-sub { font-size: 22rpx; margin: 6rpx 0; }
.rec-bottom { display: flex; justify-content: space-between; align-items: center; }
.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(35, 38, 47, 0.06);
}
.chat-input {
  flex: 1;
  background: var(--bg);
  border-radius: 36rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.chat-send { width: 130rpx; height: 68rpx; }

/* ── 澄清选项（第五十七轮）────────────────────────────────────────────────
   胶囊四条齐备：显式 height + line-height:1 + 半径=半高 + **容器 align-items:center**。
   最后一条最容易漏：容器是 flex 时子项默认 align-items:stretch，会被拉到与容器等高，
   看起来就是「框比字大、各排高矮不一」（R54 教训，已写成静态检查规则 7）。 */
.clarify-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 4rpx 108rpx;
}
.clarify-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 60rpx;
  line-height: 1;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: #fff;
  border: 2rpx solid var(--brand);
  color: var(--brand);
  font-size: 26rpx;
  white-space: nowrap;
}

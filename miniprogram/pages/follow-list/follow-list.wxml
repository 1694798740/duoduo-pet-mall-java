<nav-bar title="关注与粉丝" back="{{true}}" />

<view class="fl-tabs">
  <view class="fl-tab {{tab === 'following' ? 'fl-tab-on' : ''}}" data-tab="following" bindtap="switchTab">
    我关注的
  </view>
  <view class="fl-tab {{tab === 'followers' ? 'fl-tab-on' : ''}}" data-tab="followers" bindtap="switchTab">
    我的粉丝
  </view>
</view>

<view wx:if="{{error && items.length === 0}}" class="error-box">
  <view>{{error}}</view>
  <button class="btn btn-plain btn-mini" bindtap="retry">重试</button>
</view>
<view wx:elif="{{items.length === 0 && !loading}}" class="empty">
  {{tab === 'followers' ? '还没有人关注你，去分享圈活跃起来吧' : '还没有关注的人，去分享圈逛逛吧'}}
</view>

<block wx:else>
  <view
    wx:for="{{items}}"
    wx:key="userId"
    class="card fl-item"
    data-user="{{item.userId}}"
    bindtap="goProfile"
  >
    <image class="fl-avatar" src="{{item.avatarSrc}}" mode="aspectFill" />
    <view class="fl-info">
      <view class="fl-nick">{{item.nickname}}</view>
      <view class="t3">{{item.timeText}}{{item.mutual ? ' · 互相关注' : ''}}</view>
    </view>
    <button
      class="btn btn-plain btn-mini"
      data-user="{{item.userId}}"
      catchtap="goChat"
    >
      💬 私信
    </button>
  </view>

  <view wx:if="{{noMore && items.length > 0}}" class="t3 fl-end">— 到底啦 —</view>
  <view wx:elif="{{loading}}" class="t3 fl-end">加载中…</view>
  <view style="height: 40rpx"></view>
</block>

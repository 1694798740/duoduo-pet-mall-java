# 前端环境变量（复制为 .env.local 后按需修改；.env.local 已被 gitignore）
#
# ⚠️ 位置：Vite 只从**应用根**读 .env —— E7 monorepo 化之后应用根是 `apps/mall/`，
#    所以本文件放在这里（原先在 `frontend/` 根）。将来 apps/admin、apps/merchant
#    各自有 .env.example。

# 生产/预发：前端与网关同源时留空；不同源时填网关地址（后端需在 CORS_ORIGINS 白名单放行）
VITE_API_BASE=

# 开发态：vite dev server 的代理目标（默认 http://localhost:8080）
VITE_DEV_API_TARGET=http://localhost:8080

# 三端互跳地址（E6 三平台独立部署）：跨站点入口是**绝对地址**，不填则用代码里的默认值。
# 三个站点必须用不同主机名 —— Cookie 是主机级作用域且不区分端口，换端口隔离不了会话。
VITE_MALL_URL=http://localhost:8088
VITE_ADMIN_URL=http://admin.localhost:8090/admin.html
VITE_MERCHANT_URL=http://merchant.localhost:8091/merchant.html

                  "  const j = pm.response.json();",
                  "  const cards = j.data.cards || [];",
                  "  pm.expect(cards.some(function (c) { return c.type === 'notification_list'; })).to.be.true;",
                  "  pm.collectionVariables.set('patchNotice', j.data.badgePatch ? String(j.data.badgePatch.notification) : '');",
                  "});"

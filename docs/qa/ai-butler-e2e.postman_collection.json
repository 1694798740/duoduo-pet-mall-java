              "host": ["{{baseUrl}}"],
              "path": ["api", "duoduo", "chat"]
            }
          }
        },
        {
          "name": "C3 未读汇总（后）与补丁一致",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('红点补丁等于服务端权威值', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const after = Number(pm.response.json().data.notice);",
                  "  const before = Number(pm.collectionVariables.get('unreadBefore'));",
                  "  const patch = pm.collectionVariables.get('patchNotice');",
                  "  if (!patch) { pm.expect(after).to.be.at.most(before); return; }",
                  "  pm.expect(after).to.eql(Number(patch));",
                  "  pm.expect(after).to.be.below(before + 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/socials/notices/unread-summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "socials", "notices", "unread-summary"]
            }
          }
        },
        {
          "name": "C4 查订单",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('订单卡片结构合法', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  const cards = (j.data.cards || []).filter(function (c) { return c.type === 'order_list'; });",
                  "  if (cards.length === 0) { pm.expect(j.data.reply).to.be.a('string').and.not.empty; return; }",
                  "  cards[0].items.forEach(function (item) {",
                  "    pm.expect(item.orderNo).to.match(/^\\d{21}$/);",
                  "    pm.expect(Number(item.amountCents)).to.be.a('number');",
                  "    pm.expect(item.pageUrl).to.match(/^\\/orders\\/\\d{21}$/);",
                  "    pm.expect(item.miniPath).to.include('pages/order-detail/order-detail');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
